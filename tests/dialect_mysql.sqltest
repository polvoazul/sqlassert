-- MySQL semantics the rules depend on (`sqlassert/dialects.py`), under its
-- default strict sql_mode only: a looser sql_mode, INSERT IGNORE and MySQL
-- before 8.4 are out of scope.
--
-- The default collations ignore case, so distinct strings may compare equal;
-- only a NO PAD binary collation compares text by identity. `||` is OR: the
-- default sql_mode has no PIPES_AS_CONCAT (ADR 0006). A
-- comparison of non-null operands is non-null; arithmetic is not modelled as
-- checked (`-x` of the least BIGINT is an exact DECIMAL), and division by zero
-- is NULL in any mode. An ENUM column
-- holds only its members, which lose trailing spaces. MySQL 8.4 ignores a
-- column-level REFERENCES, and only InnoDB (and NDB) enforces foreign keys:
-- a table must name its ENGINE for them to be Knowledge.

-- dialect: mysql
CREATE TABLE t (id INT PRIMARY KEY, n INT NOT NULL, m INT, s VARCHAR(10), b VARCHAR(10) COLLATE utf8mb4_0900_bin, e ENUM('a', 'b ') NOT NULL);

-- case: pipes_are_or
SELECT m FROM t WHERE m = 1 || m = 2 /**ASSERT NOT NULL(m)**/  --~ PROVED

-- case: pipes_bind_as_loosely_as_or
-- `m = 1 AND n = 1 || m = 2` is `(m = 1 AND n = 1) OR m = 2`.
SELECT m FROM t WHERE m = 1 AND n = 1 || m = 2 /**ASSERT NOT NULL(m)**/  --~ PROVED
/**ASSERT ENUM(m IN (1, 2))**/  --~ PROVED

-- case: or_is_or
SELECT n FROM t WHERE id = 1 AND (n = 1 OR m = 2) /**ASSERT UNIQUE(n)**/  --~ PROVED

-- case: concat_is_null_when_an_argument_is
SELECT concat(s, 'x') AS v FROM t /**ASSERT NOT NULL(v)**/  --~ UNKNOWN

-- case: concat_of_non_null_arguments_is_non_null
SELECT concat(n, 'x') AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: a_comparison_of_non_null_operands_is_non_null
SELECT n > 0 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: addition_is_not_modelled_as_checked
SELECT n + 1 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ UNKNOWN

-- case: division_may_be_null
SELECT n / 2 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ UNKNOWN

-- case: text_under_the_default_collation_may_equal_distinct_strings
SELECT s FROM t WHERE s IN ('a', 'b') AND s = 'B' /**ASSERT ENUM(s IN ('a'))**/  --~ UNKNOWN

-- case: text_under_a_binary_collation_is_not_modelled
-- Any COLLATE, binary or not, is not taken to compare by identity (issue 49).
SELECT b FROM t WHERE b IN ('a', 'b') AND b = 'B' /**ASSERT ENUM(b IN ('a'))**/  --~ UNKNOWN

-- case: an_enum_column_holds_its_members_without_trailing_spaces
SELECT e FROM t /**ASSERT ENUM(e IN ('a', 'b'))**/  --~ PROVED

-- case: an_enum_case_over_its_members_is_exhaustive
SELECT /**ASSERT EXHAUSTIVE**/ CASE e WHEN 'a' THEN 1 WHEN 'b' THEN 2 END AS v FROM t  --~ PROVED

-- case: an_enum_column_compares_without_case
-- 'A' matches the member 'a'.
SELECT e FROM t WHERE e = 'A' /**ASSERT ENUM(e IN ('a'))**/  --~ UNKNOWN

-- case: a_column_level_references_is_ignored
-- trust_unenforced_keys: false
CREATE TABLE o (id INT PRIMARY KEY, t_id INT REFERENCES t (id));
--~ unenforced-constraint "column-level REFERENCES"
SELECT t_id FROM o /**ASSERT FOREIGN KEY(t_id) REFERENCES t(id)**/  --~ UNKNOWN

-- case: a_table_level_foreign_key_is_enforced
CREATE TABLE o (id INT PRIMARY KEY, t_id INT, FOREIGN KEY (t_id) REFERENCES t (id)) ENGINE=InnoDB;
SELECT t_id FROM o /**ASSERT FOREIGN KEY(t_id) REFERENCES t(id)**/  --~ PROVED

-- case: a_foreign_key_of_a_table_naming_no_engine_is_unknown
-- default_storage_engine decides, and may be MyISAM.
-- trust_unenforced_keys: false
CREATE TABLE o (id INT PRIMARY KEY, t_id INT, FOREIGN KEY (t_id) REFERENCES t (id));
--~ unenforced-constraint "names no ENGINE" "ENGINE=InnoDB"
SELECT t_id FROM o /**ASSERT FOREIGN KEY(t_id) REFERENCES t(id)**/  --~ UNKNOWN

-- case: a_myisam_table_ignores_foreign_keys
-- trust_unenforced_keys: false
CREATE TABLE o (id INT PRIMARY KEY, t_id INT, FOREIGN KEY (t_id) REFERENCES t (id)) ENGINE=MyISAM;
--~ unenforced-constraint "ENGINE=myisam"
SELECT t_id FROM o /**ASSERT FOREIGN KEY(t_id) REFERENCES t(id)**/  --~ UNKNOWN

-- case: a_primary_key_is_unique_and_non_null
SELECT id FROM t /**ASSERT NOT NULL UNIQUE(id)**/  --~ PROVED

-- case: a_loose_group_by_keeps_one_row_per_group
-- Without ONLY_FULL_GROUP_BY, `s` is some row's value.
SELECT n, s FROM t GROUP BY n /**ASSERT UNIQUE(n)**/  --~ PROVED
