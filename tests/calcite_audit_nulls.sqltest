-- Issue 40 pilot: predicate inference and null rejection against Apache Calcite
-- (commit 180f167e65f28c160d4d6ffab35fa37303f0ebe0, read from source, not run).
--
-- Expectations follow sqlassert's Property contracts, not Calcite's answers.
-- An UNKNOWN whose Property holds on every instance is a missing proof; the
-- comment above the case says so. The schema follows MockCatalogReaderSimple:
-- EMP has every column NOT NULL but MGR, EMPNO a key; EMP_NULLABLES has every
-- column nullable; DEPT has DEPTNO a key and NAME NOT NULL.

CREATE TABLE emp (empno INTEGER PRIMARY KEY, ename VARCHAR NOT NULL, mgr INTEGER, sal INTEGER NOT NULL, comm INTEGER NOT NULL, deptno INTEGER NOT NULL);
CREATE TABLE emp_nullables (empno INTEGER PRIMARY KEY, ename VARCHAR, mgr INTEGER, sal INTEGER, comm INTEGER, deptno INTEGER);
CREATE TABLE dept (deptno INTEGER PRIMARY KEY, name VARCHAR NOT NULL);

-- Null rejection (Strong) ---------------------------------------------------

-- case: strong_and_rejects_padded_side_through_one_part
-- inspired by RexProgramTest.testStrong, isNotTrue(and(i0NotNull, i1NotNull), c1)
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE e.sal IS NOT NULL AND d.name IS NOT NULL
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- A padded row is NULL in every column its join pads at once, so a condition
-- NULL or FALSE there on every part rejects that padding (per padding, not
-- per column).
-- case: strong_or_of_two_padded_columns
-- inspired by RexProgramTest.testStrong, isNull(or(i0, i1), c01), via RelOptUtil.simplifyJoin
-- A padded row fails both parts, so the join matched.
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE e.sal > 0 OR e.comm > 0
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- case: strong_or_of_is_not_null_on_padded_columns
-- inspired by RexProgramTest.testStrong, isNotTrue(or(i0NotNull, i1NotNull), c01)
-- Both parts are FALSE on a padded row.
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE e.sal IS NOT NULL OR e.comm IS NOT NULL
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- case: strong_coalesce_of_padded_columns
-- inspired by RexProgramTest.testStrong (COALESCE is null when all operands are)
-- Coalesce of two padded columns is NULL on a padded row.
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE coalesce(e.sal, e.comm) > 0
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- Columns padded by two different joins: a row may be padded by one and keep
-- the other's value.
-- case: strong_or_of_columns_two_joins_pad
-- inspired by issue 45 item 9 (boundary)
SELECT d.deptno, e.empno
FROM dept AS d
LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
LEFT JOIN emp_nullables AS e2 ON e2.deptno = d.deptno
WHERE e.sal > 0 OR e2.comm > 0
/**ASSERT NOT NULL(empno)**/  --~ UNKNOWN

-- case: strong_coalesce_of_columns_two_joins_pad
-- inspired by issue 45 item 9 (boundary)
SELECT d.deptno, e.empno
FROM dept AS d
LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
LEFT JOIN emp_nullables AS e2 ON e2.deptno = d.deptno
WHERE e.sal IS NOT NULL OR coalesce(e2.comm, e.comm) IS NOT NULL
/**ASSERT NOT NULL(empno)**/  --~ UNKNOWN

-- A nullable column of the preserved side may be TRUE on a padded row.
-- case: strong_or_with_a_nullable_preserved_part
-- inspired by issue 45 item 9 (boundary)
SELECT d.deptno, e.empno
FROM emp_nullables AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE e.sal > 0 OR d.comm > 0
/**ASSERT NOT NULL(empno)**/  --~ UNKNOWN

-- case: strong_or_with_a_preserved_part
-- inspired by RexProgramTest.testStrong, isNull(or(i0, i1), c0) is false
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE e.sal > 0 OR d.name = 'x'
/**ASSERT NOT NULL(empno)**/  --~ UNKNOWN

-- case: strong_not_is_not_null_keeps_padding
-- inspired by RexProgramTest.testStrong, "Join-strengthening relies on this" (not(isNotNull(i0)))
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE NOT (e.sal IS NOT NULL)
/**ASSERT NOT NULL(empno)**/  --~ UNKNOWN

-- case: strong_right_join_through_arithmetic
-- inspired by RelOptUtil.simplifyJoin (generatesNullsOnLeft), Strong policy ANY for PLUS
SELECT d.deptno, e.empno
FROM emp_nullables AS e RIGHT JOIN dept AS d ON e.deptno = d.deptno
WHERE e.sal + d.deptno > 0
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- case: strong_full_join_where_rejects_its_own_side
-- inspired by RelOptUtil.simplifyJoin (FULL cancels nulls on one side only)
SELECT d.deptno AS dno, e.empno
FROM dept AS d FULL JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE e.sal > 0
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- case: strong_search_with_null_value
-- inspired by Strong.isNull, SEARCH with nullAs UNKNOWN
SELECT empno, sal FROM emp_nullables WHERE sal IN (1, NULL)
/**ASSERT NOT NULL(sal)**/  --~ PROVED
/**ASSERT ENUM(sal IN (1))**/  --~ PROVED

-- case: strong_is_not_distinct_from_a_literal
-- inspired by RexUtil.predicateConstants (IS_NOT_DISTINCT_FROM gathers a constant)
-- NULL IS NOT DISTINCT FROM 1 is FALSE, so sal is 1.
SELECT empno, sal FROM emp_nullables WHERE sal IS NOT DISTINCT FROM 1
/**ASSERT NOT NULL(sal)**/  --~ PROVED
/**ASSERT ENUM(sal IN (1))**/  --~ PROVED

-- case: strong_is_not_distinct_from_a_non_null_column
-- inspired by RexUtil.predicateConstants, as above, against a column
SELECT e.empno, e.sal FROM emp_nullables AS e JOIN dept AS d ON e.sal IS NOT DISTINCT FROM d.deptno
/**ASSERT NOT NULL(sal)**/  --~ PROVED

-- case: strong_is_not_distinct_from_a_nullable_column
-- NULL IS NOT DISTINCT FROM NULL is TRUE.
SELECT empno, sal, comm FROM emp_nullables WHERE sal IS NOT DISTINCT FROM comm
/**ASSERT NOT NULL(sal)**/  --~ UNKNOWN
/**ASSERT DETERMINES(sal -> comm)**/  --~ PROVED

-- case: strong_is_not_distinct_from_a_literal_where_a_failed_cast_is_null
-- dialect: hive
-- A failed implicit cast is NULL: sal <=> 'x' is sal IS NULL.
SELECT empno, sal FROM emp_nullables WHERE sal <=> 1
/**ASSERT NOT NULL(sal)**/  --~ UNKNOWN

-- case: strong_is_not_distinct_from_a_literal_under_ansi_mode
-- dialect: databricks
-- A failed implicit cast raises, so sal <=> 1 rejects a NULL sal.
SELECT empno, sal FROM emp_nullables WHERE sal <=> 1
/**ASSERT NOT NULL(sal)**/  --~ PROVED

-- case: strong_nullif_first_argument
-- inspired by RexProgramTest.testStrong, NULLIF(null, X) is null
-- nullif is strict in its first argument (issue 45, item 13).
SELECT empno, sal FROM emp_nullables WHERE nullif(sal, 0) > 1
/**ASSERT NOT NULL(sal)**/  --~ PROVED

-- case: strong_trim_and_floor
-- inspired by Strong.createPolicyMap (TRIM, FLOOR are Policy.ANY)
-- Both are strict Builtins (issue 45, item 13).
SELECT empno, ename, sal FROM emp_nullables WHERE trim(ename) = 'a' AND floor(sal) = 1
/**ASSERT NOT NULL(ename)**/  --~ PROVED
/**ASSERT NOT NULL(sal)**/  --~ PROVED

-- case: strong_item_of_a_list
-- inspired by RexProgramTest.testItemStrong
-- xs[1] is NULL when xs is (DuckDB and PostgreSQL, certified).
CREATE TABLE lists (id INTEGER PRIMARY KEY, xs INTEGER[]);
SELECT id, xs FROM lists WHERE xs[1] = 5
/**ASSERT NOT NULL(xs)**/  --~ PROVED

-- case: strong_item_of_a_list_may_be_null
-- An element is NULL past the end of a non-null list, or where it is NULL.
CREATE TABLE lists (id INTEGER PRIMARY KEY, xs INTEGER[] NOT NULL);
SELECT id, xs[1] AS x FROM lists
/**ASSERT NOT NULL(x)**/  --~ UNKNOWN

-- case: strong_item_of_a_list_not_modelled
-- dialect: databricks
-- Subscripts are modelled only where certified (Apache Spark, not Databricks).
CREATE TABLE lists (id INTEGER PRIMARY KEY, xs ARRAY<INT>);
SELECT id, xs FROM lists WHERE xs[1] = 5
/**ASSERT NOT NULL(xs)**/  --~ UNKNOWN

-- case: strong_any_subquery_is_never_true_on_null
-- inspired by Strong.isNull (SOME over a RexSubQuery is not null-strong)
-- NULL > ANY is FALSE over no rows and NULL otherwise, never TRUE, so it rejects sal.
SELECT empno, sal FROM emp_nullables WHERE sal > ANY (SELECT comm FROM emp)
/**ASSERT NOT NULL(sal)**/  --~ PROVED

-- case: strong_any_subquery_is_not_strict
-- A conjunct that rejects sal is no value NULL with it: a is FALSE over no rows.
-- (NULL > ANY (...)) IS FALSE is TRUE over no rows, so the WHERE rejects nothing.
SELECT empno, sal, sal > ANY (SELECT comm FROM emp) AS a
FROM emp_nullables
WHERE (sal > ANY (SELECT comm FROM emp)) IS FALSE
/**ASSERT NOT NULL(sal)**/  --~ UNKNOWN
/**ASSERT NOT NULL(a)**/  --~ UNKNOWN

-- case: strong_all_subquery_is_true_over_no_rows
-- inspired by Strong.isNull, "select NULL > all (select comm from emp where 1 = 0)"
SELECT empno, sal FROM emp_nullables WHERE sal > ALL (SELECT comm FROM emp WHERE 1 = 0)
/**ASSERT NOT NULL(sal)**/  --~ UNKNOWN

-- case: strong_is_true_rejects
-- inspired by Strong.isNotTrue (IS_TRUE falls to isNull, Policy.NOT_NULL)
-- (NULL > 0) IS TRUE is FALSE: never TRUE on a NULL sal, though never NULL.
SELECT empno, sal, (sal > 0) IS TRUE AS t, (sal > 0) IS FALSE AS f FROM emp_nullables WHERE (sal > 0) IS TRUE
/**ASSERT NOT NULL(sal)**/  --~ PROVED
/**ASSERT NOT NULL(t, f)**/  --~ PROVED

-- case: strong_is_true_rejects_a_padded_side
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE (e.sal > 0) IS TRUE
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- case: strong_is_true_of_a_rejecting_operand
-- p IS TRUE is TRUE only where p is, so it rejects what p rejects: a NULL sal
-- makes sal > ANY (...) never TRUE, and sal IS NOT NULL FALSE.
SELECT empno, sal, comm FROM emp_nullables
WHERE (sal > ANY (SELECT comm FROM emp)) IS TRUE AND (comm IS NOT NULL) IS TRUE
/**ASSERT NOT NULL(sal, comm)**/  --~ PROVED

-- case: strong_is_true_of_a_rejecting_operand_rejects_a_padded_side
SELECT d.deptno, e.empno
FROM dept AS d LEFT JOIN emp_nullables AS e ON e.deptno = d.deptno
WHERE (e.sal > ANY (SELECT comm FROM emp)) IS TRUE
/**ASSERT NOT NULL(empno)**/  --~ PROVED

-- case: strong_is_not_true_of_a_rejecting_operand_rejects_nothing
-- (NULL > ANY (...)) IS NOT TRUE is TRUE.
SELECT empno, sal FROM emp_nullables WHERE (sal > ANY (SELECT comm FROM emp)) IS NOT TRUE
/**ASSERT NOT NULL(sal)**/  --~ UNKNOWN

-- case: strong_nondeterministic_conjunct_still_rejects
-- inspired by RelMetadataTest.testGetPredicatesForFilter (retainDeterministic drops it)
SELECT empno, sal FROM emp_nullables WHERE sal = random()
/**ASSERT NOT NULL(sal)**/  --~ PROVED

-- case: strong_rejected_computed_column
-- inspired by RelMetadataTest.testPredicates, "MGR IS NOT NULL OR MGR_COMM IS NOT NULL"
-- ms = mgr + sal is non-null, so mgr is: computed from the same row, by a strict +.
SELECT q.empno, q.mgr
FROM (SELECT empno, mgr, mgr + sal AS ms FROM emp_nullables) AS q
WHERE q.ms > 0
/**ASSERT NOT NULL(mgr)**/  --~ PROVED

-- case: strong_rejected_computed_column_through_a_join
SELECT q.empno, q.mgr, d.name
FROM (SELECT empno, deptno, mgr, mgr + sal AS ms FROM emp_nullables) AS q
JOIN dept AS d ON d.deptno = q.deptno
WHERE q.ms > 0
/**ASSERT NOT NULL(mgr)**/  --~ PROVED

-- case: strong_rejected_computed_column_not_strict
-- coalesce(mgr, sal) is non-null with mgr NULL.
SELECT q.empno, q.mgr
FROM (SELECT empno, mgr, coalesce(mgr, sal) AS ms FROM emp_nullables) AS q
WHERE q.ms > 0
/**ASSERT NOT NULL(mgr)**/  --~ UNKNOWN

-- case: strong_rejected_computed_column_of_another_row
-- a and b are two rows of one CTE: b's ms says nothing of a's mgr.
WITH c AS (SELECT empno, mgr, mgr + sal AS ms FROM emp_nullables)
SELECT a.mgr AS a_mgr, b.mgr AS b_mgr
FROM c AS a JOIN c AS b ON b.empno < a.empno
WHERE b.ms > 0
/**ASSERT NOT NULL(b_mgr)**/  --~ PROVED
/**ASSERT NOT NULL(a_mgr)**/  --~ UNKNOWN

-- case: strong_rejected_computed_column_of_a_group
-- m and s come from different rows of a group.
SELECT q.deptno, q.m
FROM (SELECT deptno, max(mgr) AS m, sum(mgr + sal) AS s FROM emp_nullables GROUP BY deptno) AS q
WHERE q.s > 0
/**ASSERT NOT NULL(m)**/  --~ UNKNOWN

-- Expression nullability (operator return types) ------------------------------

-- case: nullability_of_comparisons_and_is_family
-- inspired by RelMetadataTest.testPullUpPredicatesFromProject3 and Strong NOT_NULL policies
-- a, c, d are never NULL; b is non-null for non-null inputs, like e.
SELECT sal IS NULL AS a, sal = comm AS b, mgr IS DISTINCT FROM sal AS c, EXISTS (SELECT 1 FROM dept) AS d, sal > comm AS e
FROM emp
/**ASSERT NOT NULL(a)**/  --~ PROVED
/**ASSERT NOT NULL(b)**/  --~ PROVED
/**ASSERT NOT NULL(c)**/  --~ PROVED
/**ASSERT NOT NULL(d)**/  --~ PROVED
/**ASSERT NOT NULL(e)**/  --~ PROVED

-- case: nullability_of_an_equality_with_a_nullable_side
-- inspired by Strong.createPolicyMap (EQUALS is Policy.ANY)
SELECT mgr = sal AS b, mgr IS NOT DISTINCT FROM sal AS c FROM emp
/**ASSERT NOT NULL(b)**/  --~ UNKNOWN
/**ASSERT NOT NULL(c)**/  --~ PROVED

-- case: nullability_of_an_equality_where_a_failed_cast_is_null
-- dialect: hive
-- A failed implicit cast is NULL: 1 = 'x' is NULL.
SELECT sal = comm AS b, sal <=> comm AS c FROM emp
/**ASSERT NOT NULL(b)**/  --~ UNKNOWN
/**ASSERT NOT NULL(c)**/  --~ PROVED

-- case: nullability_of_concat_operator
-- inspired by SqlStdOperatorTable.CONCAT (nullable only if an operand is)
-- Proved since issue 44's dialects: DuckDB's || is strict. Oracle reads NULL as '' there.
SELECT ename || ename AS f FROM emp
/**ASSERT NOT NULL(f)**/  --~ PROVED

-- case: nullability_of_mod_by_zero_duckdb
-- inspired by Strong.createPolicyMap and ReturnTypes for MOD (non-null for non-null operands)
SELECT sal % comm AS m FROM emp
/**ASSERT NOT NULL(m)**/  --~ UNKNOWN

-- case: nullability_of_mod_by_zero_postgres
-- inspired by Strong.createPolicyMap and ReturnTypes for MOD (non-null for non-null operands)
-- dialect: postgres
SELECT sal % comm AS m FROM emp
/**ASSERT NOT NULL(m)**/  --~ PROVED

-- case: nullability_of_greatest_duckdb
-- inspired by SqlLibraryOperators.GREATEST_PG (kind GREATEST_PG, not Policy.ANY)
-- DuckDB's greatest skips NULLs, so one non-null argument suffices (as PostgreSQL's).
SELECT greatest(mgr, 1) AS g, least(1, mgr) AS l, greatest(mgr, mgr) AS n FROM emp
/**ASSERT NOT NULL(g, l)**/  --~ PROVED
/**ASSERT NOT NULL(n)**/  --~ UNKNOWN

-- case: nullability_of_greatest_mysql
-- dialect: mysql
-- MySQL's greatest is NULL when any argument is: not modelled.
SELECT greatest(mgr, 1) AS g FROM emp
/**ASSERT NOT NULL(g)**/  --~ UNKNOWN

-- case: nullability_of_grouped_max_and_sum
-- inspired by RelMetadataTest.testPullUpPredicatesFromAggregation and ReturnTypes.ARG0_NULLABLE_IF_EMPTY
-- A group is never empty, b is a non-null 2, so max(b) is 2 and non-null, like sum(b).
SELECT a, max(b) AS mb, sum(b) AS sb
FROM (SELECT 1 AS a, 2 AS b FROM emp) AS subq
GROUP BY a
/**ASSERT ENUM(a IN (1))**/  --~ PROVED
/**ASSERT ENUM(mb IN (2))**/  --~ PROVED
/**ASSERT NOT NULL(mb, sb)**/  --~ PROVED

-- case: nullability_of_scalar_max
-- inspired by RelMdPredicates.getPredicates(Aggregate), "GROUP BY () can convert an empty relation"
-- NOT NULL is false (no input rows); ENUM holds, NULL being outside it.
SELECT max(sal) AS m FROM emp WHERE sal = 5
/**ASSERT NOT NULL(m)**/  --~ UNKNOWN
/**ASSERT ENUM(m IN (5))**/  --~ PROVED

-- Predicate pull-up (RelMdPredicates) ------------------------------------------

-- case: pullup_project_constants
-- inspired by RelMetadataTest.testPullUpPredicatesOnConstant
-- CAST('1' AS INTEGER) is the constant 1 in every dialect; CAST(NULL AS INTEGER) is NULL.
SELECT deptno, mgr, x, 'y' AS y, z
FROM (
    SELECT deptno, mgr, CAST(NULL AS INTEGER) AS x, CAST('1' AS INTEGER) AS z
    FROM emp
    WHERE mgr IS NULL AND deptno < 10
) AS q
/**ASSERT ENUM(y IN ('y'))**/  --~ PROVED
/**ASSERT NOT NULL(y)**/  --~ PROVED
/**ASSERT DETERMINES(deptno -> y, mgr, x)**/  --~ PROVED
/**ASSERT ENUM(z IN (1))**/  --~ PROVED

-- case: pullup_project_is_null_of_constrained_column
-- inspired by RelMetadataTest.testPullUpPredicatesFromProject3
-- comm = 2 rejects NULL, so a is FALSE and b TRUE on every row.
SELECT comm IS NULL AS a, comm IS NOT NULL AS b FROM emp_nullables WHERE comm = 2
/**ASSERT ENUM(a IN (FALSE))**/  --~ PROVED
/**ASSERT ENUM(b IN (TRUE))**/  --~ PROVED
/**ASSERT NOT NULL(a, b)**/  --~ PROVED

-- case: pullup_project_is_null_of_nullable_column
-- Without the WHERE comm may be NULL or not; NULL IS NULL is TRUE.
SELECT comm IS NULL AS a, NULL IS NULL AS c, CAST(NULL AS INTEGER) IS NOT NULL AS d FROM emp_nullables
/**ASSERT ENUM(a IN (FALSE))**/  --~ UNKNOWN
/**ASSERT ENUM(a IN (TRUE))**/  --~ UNKNOWN
/**ASSERT ENUM(c IN (TRUE))**/  --~ PROVED
/**ASSERT ENUM(d IN (FALSE))**/  --~ PROVED

-- case: pullup_inner_join_on_nullable_column
-- inspired by RelMetadataTest.testPredicates, "IS NOT NULL($0)" from e.MGR = d.DEPTNO
SELECT e.mgr
FROM (SELECT * FROM emp WHERE empno = 1) AS e
JOIN dept AS d ON e.mgr = d.deptno
/**ASSERT NOT NULL(mgr)**/  --~ PROVED

-- case: pullup_inner_join_transitive_constant
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference (equivalence closure)
SELECT e.ename, e.deptno
FROM emp AS e JOIN dept AS d ON e.deptno = d.deptno AND d.deptno = 10
/**ASSERT ENUM(deptno IN (10))**/  --~ PROVED
/**ASSERT DETERMINES(ename -> deptno)**/  --~ PROVED

-- case: pullup_semi_join_from_in_subquery
-- inspired by RelMetadataTest.testPredicates (semiJoin keeps left predicates and leftInferredPredicates)
SELECT e.empno, e.mgr
FROM emp AS e
WHERE e.mgr IN (SELECT d.deptno FROM dept AS d WHERE d.deptno = 10)
/**ASSERT ENUM(mgr IN (10))**/  --~ PROVED
/**ASSERT NOT NULL(mgr)**/  --~ PROVED

-- case: pullup_semi_join_from_exists_on_constant
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference.inferPredicates (SEMI)
-- mgr equals d.deptno of the matched dept row, which the ON constant pins to
-- 10 (same type: equal values are identical).
SELECT e.empno, e.mgr
FROM emp AS e
WHERE EXISTS (SELECT 1 FROM dept AS d WHERE d.deptno = e.mgr AND d.deptno = 10)
/**ASSERT ENUM(mgr IN (10))**/  --~ PROVED
/**ASSERT NOT NULL(mgr)**/  --~ PROVED

-- case: pullup_semi_join_equates_two_left_columns
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference (ON equalities are not pulled up for SEMI)
-- mgr and comm each equal d.deptno of the matched dept row, all INTEGER, so
-- they are equal: one Equality Group, a dependency each way.
SELECT e.empno, e.mgr, e.comm
FROM emp_nullables AS e
WHERE EXISTS (SELECT 1 FROM dept AS d WHERE d.deptno = e.mgr AND d.deptno = e.comm)
  AND e.mgr IN (1, 2)
/**ASSERT DETERMINES(mgr -> comm)**/  --~ PROVED
/**ASSERT DETERMINES(comm -> mgr)**/  --~ PROVED
/**ASSERT ENUM(comm IN (1, 2))**/  --~ PROVED
/**ASSERT NOT NULL(mgr, comm)**/  --~ PROVED

-- case: pullup_semi_join_null_safe_through_a_right_column
-- IS NOT DISTINCT FROM equates NULLs too: mgr and comm are equal or both NULL.
SELECT e.empno, e.mgr, e.comm
FROM emp_nullables AS e
WHERE EXISTS (SELECT 1 FROM dept AS d WHERE d.deptno IS NOT DISTINCT FROM e.mgr AND d.deptno IS NOT DISTINCT FROM e.comm)
/**ASSERT DETERMINES(mgr -> comm)**/  --~ PROVED
/**ASSERT DETERMINES(comm -> mgr)**/  --~ PROVED

-- case: pullup_semi_join_through_a_wider_type
-- Two INTEGERs equal to one DOUBLE need not be equal: above 2^53 distinct
-- integers cast to one double.
CREATE TABLE measure (id INTEGER PRIMARY KEY, v DOUBLE NOT NULL);
SELECT e.empno, e.mgr, e.comm
FROM emp AS e
WHERE EXISTS (SELECT 1 FROM measure AS m WHERE m.v = e.mgr AND m.v = e.comm)
/**ASSERT DETERMINES(mgr -> comm)**/  --~ UNKNOWN

-- case: pullup_semi_join_through_a_collation
-- 'x' = c.a = 'X' under NOCASE: ename need not be 'x', nor equal name.
CREATE TABLE coll_ci (id INTEGER PRIMARY KEY, a VARCHAR COLLATE NOCASE NOT NULL);
SELECT e.empno, e.ename, d.name
FROM emp AS e JOIN dept AS d ON d.deptno = e.deptno
WHERE EXISTS (SELECT 1 FROM coll_ci AS c WHERE c.a = e.ename AND c.a = d.name AND c.a = 'x')
/**ASSERT ENUM(ename IN ('x'))**/  --~ UNKNOWN
/**ASSERT DETERMINES(ename -> name)**/  --~ UNKNOWN

-- case: pullup_semi_join_through_a_right_column_only_or_bound
-- An OR in the EXISTS body bounds the matched row's column only when every
-- part does.
SELECT e.empno, e.mgr
FROM emp AS e
WHERE EXISTS (SELECT 1 FROM dept AS d WHERE d.deptno = e.mgr AND (d.deptno = 10 OR d.name = 'x'))
/**ASSERT ENUM(mgr IN (10))**/  --~ UNKNOWN

-- case: pullup_anti_join_keeps_left_only
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference.inferPredicates (ANTI pulls up the left only)
SELECT e.empno, e.mgr
FROM emp AS e
WHERE NOT EXISTS (SELECT 1 FROM dept AS d WHERE d.deptno = e.mgr AND d.deptno = 10)
/**ASSERT ENUM(mgr IN (10))**/  --~ UNKNOWN
/**ASSERT NOT NULL(mgr)**/  --~ UNKNOWN

-- case: pullup_left_join_padded_on_constant
-- inspired by RelMdPredicates class comment, "For Left Outer ... No predicates are pulledUp"
-- Stronger than Calcite: on the padded side the ON constant holds or the column is NULL.
SELECT d.deptno, e.sal
FROM dept AS d LEFT JOIN emp AS e ON e.deptno = d.deptno AND e.sal = 5
/**ASSERT ENUM(sal IN (5))**/  --~ PROVED
/**ASSERT NOT NULL(sal)**/  --~ UNKNOWN

-- case: pullup_left_join_preserved_on_conjunct
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference.inferPredicates (LEFT: ON is not pulled up)
SELECT d.deptno, d.name, e.empno
FROM dept AS d LEFT JOIN emp AS e ON e.deptno = d.deptno AND d.name = 'x'
/**ASSERT ENUM(name IN ('x'))**/  --~ UNKNOWN

-- case: pullup_left_join_preserved_domain_below_the_join
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference (LEFT: left predicates inferred onto the right)
SELECT d.deptno, e.deptno AS edeptno
FROM (SELECT * FROM dept WHERE deptno IN (1, 2)) AS d
LEFT JOIN emp AS e ON e.deptno = d.deptno
/**ASSERT ENUM(edeptno IN (1, 2))**/  --~ PROVED

-- case: pullup_left_join_preserved_domain_above_the_join
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference (LEFT: left predicates inferred onto the right)
-- Missing proof: matched rows have e.deptno = d.deptno, which the WHERE bounds (issue 37, E4).
SELECT d.deptno, e.deptno AS edeptno
FROM dept AS d LEFT JOIN emp AS e ON e.deptno = d.deptno
WHERE d.deptno IN (1, 2)
/**ASSERT ENUM(edeptno IN (1, 2))**/  --~ UNKNOWN

-- case: pullup_full_join_input_predicates
-- inspired by RelMdPredicates class comment, "For Full Outer Joins no predicates are pulledUp"
SELECT d.name, e.sal
FROM (SELECT * FROM dept WHERE name = 'x') AS d
FULL JOIN (SELECT * FROM emp WHERE sal = 3) AS e ON e.deptno = d.deptno
/**ASSERT ENUM(name IN ('x'))**/  --~ PROVED
/**ASSERT ENUM(sal IN (3))**/  --~ PROVED
/**ASSERT NOT NULL(name)**/  --~ UNKNOWN

-- case: pullup_aggregate_rollup
-- inspired by RelMdPredicates.allGroupSetsOverlap ("deptno may be NULL as well")
-- NOT NULL is false (subtotal rows); ENUM holds, NULL being outside it: a
-- missing proof (ROLLUP is not lowered; issue 42).
SELECT deptno, sal, count(*) AS n FROM emp WHERE deptno = 10 GROUP BY ROLLUP (sal, deptno)
/**ASSERT NOT NULL(deptno)**/  --~ UNKNOWN
--~ unsupported-construct "ROLLUP"
/**ASSERT ENUM(deptno IN (10))**/  --~ UNKNOWN
--~ unsupported-construct "ROLLUP"

-- case: pullup_aggregate_having_on_group_key
-- inspired by RelMdPredicates.getPredicates(Filter) over getPredicates(Aggregate)
-- HAVING filters the groups (issue 45).
SELECT deptno, count(*) AS n FROM emp GROUP BY deptno HAVING deptno = 10
/**ASSERT ENUM(deptno IN (10))**/  --~ PROVED

-- case: pullup_union_common_and_disjunctive
-- inspired by RelMetadataTest.testPullUpPredicatesFromUnion2
-- Missing proof: empno is the constant 1 in both inputs (issue 37, U2).
WITH u AS (
    SELECT empno, comm, deptno FROM emp_nullables WHERE empno = 1 AND comm = 2 AND deptno = 3
    UNION ALL
    SELECT empno, comm, deptno FROM emp_nullables WHERE empno = 1 AND comm = 4
)
SELECT empno, comm, deptno FROM u
/**ASSERT ENUM(empno IN (1))**/  --~ PROVED
/**ASSERT ENUM(comm IN (2, 4))**/  --~ PROVED
/**ASSERT NOT NULL(empno, comm)**/  --~ PROVED
/**ASSERT ENUM(deptno IN (3))**/  --~ UNKNOWN
/**ASSERT DETERMINES(deptno -> empno)**/  --~ UNKNOWN

-- case: pullup_union_with_null_literal
-- inspired by RelMetadataTest.testPullUpPredicatesFromUnionWithValues1
WITH u AS (SELECT NULL AS a UNION ALL SELECT 5 AS a)
SELECT a FROM u
/**ASSERT ENUM(a IN (5))**/  --~ PROVED
/**ASSERT NOT NULL(a)**/  --~ UNKNOWN

-- case: pullup_union_with_cast_null
-- inspired by RelMetadataTest.testPullUpPredicatesFromUnionWithValues1
-- CAST is strict, so CAST(NULL AS INTEGER) is NULL, outside every domain.
WITH u AS (SELECT CAST(NULL AS INTEGER) AS a UNION ALL SELECT 5 AS a)
SELECT a FROM u
/**ASSERT ENUM(a IN (5))**/  --~ PROVED

-- case: pullup_project_casts_folded_only_when_exact
-- Only a plain integer literal within the type's range is folded: CAST('1.5' AS
-- INTEGER) rounds or truncates by dialect, '01' and ' 1' are not plain, 300
-- overflows a TINYINT, and a TRY_CAST may be NULL. g is NULL on every row
-- (+ is strict), so it has no non-null value and every ENUM holds.
SELECT CAST('1.5' AS INTEGER) AS a, CAST('01' AS INTEGER) AS b, CAST(' 1' AS INTEGER) AS c, CAST(300 AS TINYINT) AS d,
    TRY_CAST('1' AS INTEGER) AS e, CAST(1 AS BIGINT) AS f, CAST(NULL AS INTEGER) + 1 AS g
FROM emp
/**ASSERT ENUM(a IN (1, 2))**/  --~ UNKNOWN
/**ASSERT ENUM(b IN (1))**/  --~ UNKNOWN
/**ASSERT ENUM(c IN (1))**/  --~ UNKNOWN
/**ASSERT ENUM(d IN (300))**/  --~ UNKNOWN
/**ASSERT ENUM(e IN (1))**/  --~ UNKNOWN
/**ASSERT ENUM(f IN (1))**/  --~ PROVED
/**ASSERT NOT NULL(f)**/  --~ PROVED
/**ASSERT ENUM(g IN (7))**/  --~ PROVED
--~ always-null-column "'g' is always NULL, so this ENUM holds trivially"

-- case: pullup_intersect_takes_both_inputs
-- inspired by RelMetadataTest.testPullUpPredicatesFromIntersect1
WITH u AS (
    SELECT empno, deptno, comm FROM emp_nullables WHERE empno = 1 AND deptno = 2
    INTERSECT ALL
    SELECT empno, deptno, comm FROM emp_nullables WHERE empno = 1 AND comm = 3
)
SELECT empno, deptno, comm FROM u
/**ASSERT ENUM(deptno IN (2))**/  --~ PROVED
/**ASSERT ENUM(comm IN (3))**/  --~ PROVED
/**ASSERT NOT NULL(deptno, comm)**/  --~ PROVED

-- case: pullup_minus_takes_the_left_input
-- inspired by RelMetadataTest.testPullUpPredicatesFromMinus
WITH u AS (
    SELECT empno, deptno, comm FROM emp_nullables WHERE empno = 1 AND deptno = 2
    EXCEPT ALL
    SELECT empno, deptno, comm FROM emp_nullables WHERE comm = 3
)
SELECT empno, deptno, comm FROM u
/**ASSERT ENUM(deptno IN (2))**/  --~ PROVED
/**ASSERT ENUM(comm IN (3))**/  --~ UNKNOWN
/**ASSERT NOT NULL(comm)**/  --~ UNKNOWN

-- case: pullup_values
-- inspired by RelMetadataTest.testPullUpPredicatesFromValues4
-- VALUES states its literals' domains and nullability (issue 45).
SELECT w, x, y, z FROM (VALUES (1, 2, 3, NULL), (1, 2, NULL, NULL), (5, 2, 3, NULL)) AS v (w, x, y, z)
/**ASSERT ENUM(w IN (1, 5))**/  --~ PROVED
/**ASSERT NOT NULL(w, x)**/  --~ PROVED
/**ASSERT ENUM(y IN (3))**/  --~ PROVED

-- case: pullup_equivalence_under_a_collation
-- inspired by RelMdPredicates.JoinConditionBasedPredicateInference.EquivalenceFinder (any `=` of two columns)
-- 'X' = 'x' under NOCASE, so b need not be 'x'.
CREATE TABLE coll (id INTEGER PRIMARY KEY, a VARCHAR COLLATE NOCASE, b VARCHAR COLLATE NOCASE);
SELECT id, a, b FROM coll WHERE a = b AND a = 'x'
/**ASSERT ENUM(b IN ('x'))**/  --~ UNKNOWN
