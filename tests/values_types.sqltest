-- The columns of a VALUES list are typed from their literals, as the engine
-- types them (`DialectSemantics.values_types`), so an equality on one binds as it
-- does on a declared column. Text binds only where the dialect's text compares by
-- identity. NULL does not change a column's type; mixed kinds, an expression, a
-- boolean, an exponent, a decimal whose whole part is 0 and an all-NULL column
-- stay untyped, and so does an integer beyond BIGINT.

CREATE TABLE t (
  id INTEGER PRIMARY KEY, code VARCHAR, name VARCHAR(20), n INTEGER, big BIGINT,
  price DECIMAL(4, 2), wide DECIMAL(10, 2), score DOUBLE, flag BOOLEAN, born DATE
);

-- case: string_column_binds_a_text_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.code = v.code
--~ PROVED

-- case: string_column_binds_a_text_column_of_another_length
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.name = v.code
--~ PROVED

-- case: string_column_with_a_null_keeps_its_type
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), (NULL, 2)) AS v (code, n) ON t.code = v.code
--~ PROVED

-- case: string_column_does_not_bind_an_integer_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.n = v.code
--~ UNKNOWN

-- case: integer_column_does_not_bind_a_text_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.code = v.n
--~ UNKNOWN

-- case: integer_column_binds_an_integer_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.n = v.n
--~ PROVED

-- case: integer_column_binds_a_bigint_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.big = v.n
--~ PROVED

-- case: integer_column_binds_a_decimal_column
-- Exact numbers compare by value whatever their scale (ADR 0007).
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.price = v.n
--~ PROVED

-- case: integer_column_does_not_bind_a_double_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.score = v.n
--~ UNKNOWN

-- case: bigint_column_binds_an_integer_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1), (3000000000)) AS v (k) ON t.n = v.k
--~ PROVED

-- case: bigint_column_binds_a_bigint_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1), (3000000000)) AS v (k) ON t.big = v.k
--~ PROVED

-- case: integer_beyond_bigint_is_untyped
-- DuckDB makes it a HUGEINT, MySQL a BIGINT UNSIGNED or DECIMAL, Postgres a NUMERIC.
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (9223372036854775808), (1)) AS v (k) ON t.big = v.k
--~ UNKNOWN

-- case: decimal_column_binds_a_decimal_column_of_its_type
-- 1.5 is DECIMAL(2, 1) and 10.25 DECIMAL(4, 2): the column is DECIMAL(4, 2).
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.price = v.k
--~ PROVED

-- case: decimal_column_binds_a_decimal_column_of_another_type
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.wide = v.k
--~ PROVED

-- case: decimal_column_binds_an_integer_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.n = v.k
--~ PROVED

-- case: decimal_column_does_not_bind_a_double_column
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (2.5)) AS v (k) ON t.score = v.k
--~ UNKNOWN

-- case: decimal_with_a_whole_part_of_zero_is_untyped
-- 0.5 is DECIMAL(2, 1) in DuckDB and MySQL, DECIMAL(1, 1) in Trino and Spark.
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (0.5), (1.25)) AS v (k) ON t.price = v.k
--~ UNKNOWN

-- case: exponent_is_untyped
-- An exponent literal is a DOUBLE.
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (1e3)) AS v (k) ON t.price = v.k
--~ UNKNOWN

-- case: integers_and_decimals_are_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1), (1.5)) AS v (k) ON t.price = v.k
--~ UNKNOWN

-- case: null_only_column_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (NULL), (NULL)) AS v (k) ON t.n = v.k
--~ UNKNOWN

-- case: mixed_string_and_integer_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a'), (1)) AS v (k) ON t.code = v.k
--~ UNKNOWN

-- case: expression_column_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a' || 'b'), ('c')) AS v (k) ON t.code = v.k
--~ UNKNOWN

-- case: arithmetic_column_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1 + 1), (3)) AS v (k) ON t.n = v.k
--~ UNKNOWN

-- case: cast_column_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (CAST('a' AS VARCHAR)), ('b')) AS v (k) ON t.code = v.k
--~ UNKNOWN

-- case: boolean_column_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (true), (false)) AS v (k) ON t.flag = v.k
--~ UNKNOWN

-- case: date_column_is_untyped
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (DATE '2024-01-01'), (DATE '2024-01-02')) AS v (k) ON t.born = v.k
--~ UNKNOWN

-- case: a_column_with_an_expression_does_not_untype_its_neighbour
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1 + 1), ('b', 3)) AS v (code, n) ON t.code = v.code
--~ PROVED

-- case: postgres_string_column_binds_a_text_column
-- dialect: postgres
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.code = v.code
--~ PROVED

-- case: postgres_integer_column_binds_an_integer_column
-- dialect: postgres
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.n = v.n
--~ PROVED

-- case: trino_string_column_binds_a_text_column
-- dialect: trino
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.code = v.code
--~ PROVED

-- case: trino_integer_column_binds_an_integer_column
-- dialect: trino
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.n = v.n
--~ PROVED

-- case: postgres_decimal_column_is_an_unscaled_numeric
-- A NUMERIC with no scale keeps each value's own scale: no decimal is claimed.
-- dialect: postgres
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.price = v.k
--~ UNKNOWN

-- case: trino_decimal_column_binds_a_decimal_column_of_its_type
-- dialect: trino
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.price = v.k
--~ PROVED

-- case: mysql_string_column_is_case_insensitive_so_it_binds_nothing
-- Spelled without ROW, as SQLGlot reads every dialect; MySQL's own ROW spelling is not lowered.
-- dialect: mysql
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.code = v.code
--~ UNKNOWN

-- case: mysql_integer_column_binds_an_integer_column
-- dialect: mysql
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.n = v.n
--~ PROVED

-- case: mysql_decimal_column_binds_a_decimal_column_of_its_type
-- dialect: mysql
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.price = v.k
--~ PROVED

-- case: spark_string_column_binds_nothing_as_text_is_not_certified_binary
-- dialect: spark
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.code = v.code
--~ UNKNOWN

-- case: spark_integer_column_binds_an_integer_column
-- dialect: spark
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES ('a', 1), ('b', 2)) AS v (code, n) ON t.n = v.n
--~ PROVED

-- case: spark_decimal_column_binds_a_decimal_column_of_its_type
-- dialect: spark
SELECT t.id FROM t
/**ASSERT MANY TO ONE**/ JOIN (VALUES (1.5), (10.25)) AS v (k) ON t.price = v.k
--~ PROVED
