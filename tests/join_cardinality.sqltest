-- Join cardinality markers, read in FROM order: the left input is everything
-- before the join, the right its joined source.
--
-- `MANY TO ONE` repeats no left row, `ONE TO MANY` no right row, `ONE TO ONE`
-- neither. `UNIQUE` (or `NOT MANY TO MANY`) is their disjunction: the join
-- repeats rows of at most one input.

CREATE TABLE customers (id INTEGER PRIMARY KEY);
CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER);
CREATE TABLE payments (customer_id INTEGER);
CREATE TABLE profiles (customer_id INTEGER PRIMARY KEY);

-- case: a_left_constant_in_on_binds_the_left_column
SELECT * FROM customers /**ASSERT ONE TO MANY**/ JOIN payments ON customers.id = 7
--~ PROVED

-- case: one_to_many_through_a_chain_needs_the_whole_left_input_unique
SELECT * FROM customers JOIN orders ON orders.customer_id = customers.id
/**ASSERT ONE TO MANY**/ JOIN payments ON payments.customer_id = customers.id
--~ UNKNOWN

-- case: the_explanation_names_the_input_that_is_unique
SELECT *
FROM customers
/**ASSERT UNIQUE**/ JOIN orders
--~ PROVED "PROVED: one_to_many_join" "UNKNOWN: many_to_one_join"
    ON orders.customer_id = customers.id

-- Implicit casts: codes.code = nums.v casts the text to a number, so '01' and
-- '1' both match 1 and the key no longer bounds the matches. On codes = '01',
-- '1' and nums = 1, 1, the join has 4 rows.
-- case: an_equality_that_casts_binds_no_column__not_many_to_many
CREATE TABLE codes (code VARCHAR PRIMARY KEY);
CREATE TABLE nums (v INTEGER);
SELECT * FROM nums /**ASSERT NOT MANY TO MANY**/ JOIN codes ON codes.code = nums.v
--~ UNKNOWN

-- case: an_equality_that_casts_binds_no_column__many_to_one
CREATE TABLE codes (code VARCHAR PRIMARY KEY);
CREATE TABLE nums (v INTEGER);
SELECT * FROM nums /**ASSERT MANY TO ONE**/ JOIN codes ON codes.code = nums.v
--~ UNKNOWN

-- case: an_equality_that_casts_binds_no_column__one_to_one
CREATE TABLE codes (code VARCHAR PRIMARY KEY);
CREATE TABLE nums (v INTEGER);
SELECT * FROM nums /**ASSERT ONE TO ONE**/ JOIN codes ON codes.code = nums.v
--~ UNKNOWN

-- Equalities on a function of the other input's row. For one row of it the
-- function is one value, so the matched column it equals is bound (`b.k =
-- -a.x`). The other way round, `-b.x = a.k` binds `b.x` too, but only
-- because `-x` is injective (exact arithmetic that raises on overflow); a
-- cast is not. Either way the comparison must lose nothing: typed alike.

-- case: a_negated_column_binds_the_matched_column
CREATE TABLE ledger (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2));
CREATE TABLE refunds (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
SELECT * FROM ledger /**ASSERT MANY TO ONE**/ JOIN refunds ON refunds.amount = -ledger.amount
--~ PROVED

-- case: a_negated_column_binds_the_matched_column__not_the_other_input
CREATE TABLE ledger (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2));
CREATE TABLE refunds (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
SELECT * FROM ledger /**ASSERT ONE TO MANY**/ JOIN refunds ON refunds.amount = -ledger.amount
--~ UNKNOWN

-- case: the_negated_matched_column_is_bound_through_its_inverse
CREATE TABLE ledger (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
CREATE TABLE refunds (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2));
SELECT * FROM ledger /**ASSERT ONE TO MANY**/ JOIN refunds ON refunds.amount = -ledger.amount
--~ PROVED

-- case: both_inputs_unique_on_the_negated_column_is_one_to_one
CREATE TABLE ledger (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
CREATE TABLE refunds (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
SELECT * FROM ledger /**ASSERT ONE TO ONE**/ JOIN refunds ON -refunds.amount = ledger.amount
--~ PROVED

-- case: an_added_literal_binds_the_matched_column
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = child.parent + 1
--~ PROVED

-- case: an_added_literal_binds_the_matched_column__not_the_other_input
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT ONE TO MANY**/ JOIN chain AS p ON p.id = child.parent + 1
--~ PROVED

-- case: an_added_literal_on_the_matched_side_is_inverted
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS a /**ASSERT MANY TO ONE**/ JOIN chain AS b ON a.id = b.parent + 1
--~ PROVED

-- case: a_subtracted_from_literal_on_the_matched_side_is_inverted
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS a /**ASSERT MANY TO ONE**/ JOIN chain AS b ON 10 - b.parent = a.id
--~ PROVED

-- case: a_function_of_the_matched_side_binds_through_a_mixed_integer_width
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
CREATE TABLE wide (id BIGINT PRIMARY KEY);
SELECT * FROM chain /**ASSERT MANY TO ONE**/ JOIN wide ON wide.id = chain.parent + 1
--~ PROVED

-- case: an_added_literal_is_not_typed_over_a_decimal
-- DuckDB's DECIMAL(10, 2) + 1 is a DECIMAL(13, 2): compared as a wider type.
CREATE TABLE ledger (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
SELECT * FROM ledger AS a /**ASSERT MANY TO ONE**/ JOIN ledger AS b ON b.amount = a.amount + 1
--~ UNKNOWN

-- case: an_added_literal_over_a_decimal_on_the_matched_side_is_not_inverted
-- The same comparison as above, from the other side: a DECIMAL beside a computed decimal.
CREATE TABLE ledger (id INTEGER PRIMARY KEY, amount DECIMAL(10, 2) UNIQUE);
SELECT * FROM ledger AS a /**ASSERT ONE TO MANY**/ JOIN ledger AS b ON b.amount = a.amount + 1
--~ UNKNOWN

-- case: an_on_equality_through_an_integer_expression_binds
CREATE TABLE keyed (k BIGINT PRIMARY KEY);
CREATE TABLE refs (r BIGINT);
SELECT * FROM refs /**ASSERT MANY TO ONE**/ JOIN keyed ON keyed.k = refs.r + 1
--~ PROVED

-- case: an_on_equality_through_a_double_expression_binds_nothing
-- k = r + 1e0 compares in DOUBLE: 2^53 and 2^53 + 1 are both equal to 2^53 - 1 + 1e0.
CREATE TABLE keyed (k BIGINT PRIMARY KEY);
CREATE TABLE refs (r BIGINT);
SELECT * FROM refs /**ASSERT MANY TO ONE**/ JOIN keyed ON keyed.k = refs.r + 1e0
--~ UNKNOWN

-- case: an_on_equality_through_a_cast_to_double_binds_nothing
CREATE TABLE keyed (k BIGINT PRIMARY KEY);
CREATE TABLE refs (r BIGINT);
SELECT * FROM refs /**ASSERT MANY TO ONE**/ JOIN keyed ON keyed.k = CAST(refs.r AS DOUBLE)
--~ UNKNOWN

-- case: an_on_equality_through_a_text_to_integer_comparison_binds_nothing
CREATE TABLE keyed (k VARCHAR PRIMARY KEY);
CREATE TABLE refs (r INTEGER);
SELECT * FROM refs /**ASSERT MANY TO ONE**/ JOIN keyed ON keyed.k = refs.r + 1
--~ UNKNOWN

-- case: a_product_of_integers_is_an_integer
-- Checked arithmetic over integers is an integer, compared by value with another (DuckDB `typeof`: INTEGER).
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = child.parent * 2
--~ PROVED

-- case: a_quotient_is_not_typed
-- DuckDB's `/` of integers is a DOUBLE; no engine's is claimed.
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = child.parent / 2
--~ UNKNOWN

-- case: a_product_on_the_matched_side_is_not_inverted
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS a /**ASSERT MANY TO ONE**/ JOIN chain AS b ON a.id = b.parent * 2
--~ UNKNOWN

-- case: a_double_is_bound_by_no_function
-- -0.0 = 0.0, and x + 1 rounds: neither the column nor its function binds.
CREATE TABLE readings (id INTEGER PRIMARY KEY, v DOUBLE UNIQUE);
SELECT * FROM readings AS a /**ASSERT MANY TO ONE**/ JOIN readings AS b ON b.v = -a.v
--~ UNKNOWN

-- case: a_double_is_bound_by_no_function__inverse
CREATE TABLE readings (id INTEGER PRIMARY KEY, v DOUBLE UNIQUE);
SELECT * FROM readings AS a /**ASSERT MANY TO ONE**/ JOIN readings AS b ON a.v = b.v + 1
--~ UNKNOWN

-- case: a_double_is_bound_by_no_function__one_to_many
CREATE TABLE readings (id INTEGER PRIMARY KEY, v DOUBLE UNIQUE);
SELECT * FROM readings AS a /**ASSERT ONE TO MANY**/ JOIN readings AS b ON a.v = b.v + 1
--~ UNKNOWN

-- case: a_cast_of_a_double_function_to_an_integer_binds_the_matched_column
CREATE TABLE readings (id INTEGER PRIMARY KEY, v DOUBLE UNIQUE);
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM readings /**ASSERT MANY TO ONE**/ JOIN chain ON chain.id = CAST(-readings.v AS INTEGER)
--~ PROVED

-- case: a_cast_binds_the_matched_column
CREATE TABLE events (id INTEGER PRIMARY KEY, ts TIMESTAMP UNIQUE);
CREATE TABLE days (day DATE PRIMARY KEY);
SELECT * FROM events /**ASSERT MANY TO ONE**/ JOIN days ON days.day = CAST(events.ts AS DATE)
--~ PROVED

-- case: a_cast_is_not_inverted
-- Many timestamps are on one day, however unique each is.
CREATE TABLE events (id INTEGER PRIMARY KEY, ts TIMESTAMP UNIQUE);
CREATE TABLE days (day DATE PRIMARY KEY);
SELECT * FROM events /**ASSERT ONE TO MANY**/ JOIN days ON days.day = CAST(events.ts AS DATE)
--~ UNKNOWN

-- case: a_cast_on_the_matched_side_is_not_inverted
CREATE TABLE events (id INTEGER PRIMARY KEY, ts TIMESTAMP UNIQUE);
CREATE TABLE days (day DATE PRIMARY KEY);
SELECT * FROM days /**ASSERT MANY TO ONE**/ JOIN events ON days.day = CAST(events.ts AS DATE)
--~ UNKNOWN

-- case: a_cast_to_text_binds_the_matched_column
CREATE TABLE codes (code VARCHAR PRIMARY KEY);
CREATE TABLE nums (v INTEGER UNIQUE);
SELECT * FROM nums /**ASSERT MANY TO ONE**/ JOIN codes ON codes.code = CAST(nums.v AS VARCHAR)
--~ PROVED

-- case: a_cast_to_text_is_not_inverted
CREATE TABLE codes (code VARCHAR PRIMARY KEY);
CREATE TABLE nums (v INTEGER UNIQUE);
SELECT * FROM nums /**ASSERT ONE TO MANY**/ JOIN codes ON codes.code = CAST(nums.v AS VARCHAR)
--~ UNKNOWN

-- A BIGINT cast to DOUBLE to be compared loses its low bits: 2^53 and 2^53 + 1
-- are one double, so two keys match one row.
-- case: a_cast_to_a_double_binds_no_integer_column
CREATE TABLE big (id BIGINT PRIMARY KEY);
CREATE TABLE readings (id INTEGER PRIMARY KEY, v DOUBLE UNIQUE);
SELECT * FROM readings /**ASSERT MANY TO ONE**/ JOIN big ON big.id = CAST(readings.v AS DOUBLE)
--~ UNKNOWN

-- case: a_cast_to_another_type_binds_no_column
-- The comparison would cast the DATE to a TIMESTAMP, whose type is not the column's.
CREATE TABLE events (id INTEGER PRIMARY KEY, ts TIMESTAMP UNIQUE);
CREATE TABLE days (day DATE PRIMARY KEY);
SELECT * FROM events /**ASSERT MANY TO ONE**/ JOIN days ON days.day = CAST(events.ts AS TIMESTAMP)
--~ UNKNOWN

-- case: a_cast_of_text_to_text_is_not_typed
CREATE TABLE codes (code VARCHAR PRIMARY KEY);
CREATE TABLE names (name VARCHAR UNIQUE);
SELECT * FROM names /**ASSERT MANY TO ONE**/ JOIN codes ON codes.code = CAST(names.name AS VARCHAR)
--~ UNKNOWN

-- case: a_function_that_may_differ_per_evaluation_binds_nothing
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = CAST(child.parent + random() AS INTEGER)
--~ UNKNOWN

-- case: nullif_of_one_type_binds
-- NULL equals nothing: a value that is NULL only removes a match.
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = nullif(child.parent, 0)
--~ PROVED

-- case: nullif_of_two_types_binds_nothing
-- DuckDB returns the type of `a` (`NULLIF(int, 1.5)` is INTEGER), but another engine may compare in the common type.
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = nullif(child.parent, 0.5)
--~ UNKNOWN

-- case: a_try_cast_binds_through_its_type
-- A failed TRY_CAST is NULL, and NULL equals nothing: it has the type it names.
CREATE TABLE events (id INTEGER PRIMARY KEY, ts TIMESTAMP UNIQUE);
CREATE TABLE days (day DATE PRIMARY KEY);
SELECT * FROM events /**ASSERT MANY TO ONE**/ JOIN days ON days.day = TRY_CAST(events.ts AS DATE)
--~ PROVED

-- IS NOT DISTINCT FROM also matches NULL to NULL: the bound column is non-null
-- only when the function is never NULL, here of a NOT NULL column.
-- case: a_null_safe_equality_on_a_function_of_a_non_null_column_is_definite
CREATE TABLE a (k INTEGER UNIQUE);
CREATE TABLE b (k INTEGER NOT NULL);
SELECT * FROM b /**ASSERT MANY TO ONE**/ JOIN a ON a.k IS NOT DISTINCT FROM -b.k
--~ PROVED

-- case: a_null_safe_equality_on_a_function_of_a_nullable_column_matches_nulls
CREATE TABLE a (k INTEGER UNIQUE);
CREATE TABLE b (k INTEGER);
SELECT * FROM b /**ASSERT MANY TO ONE**/ JOIN a ON a.k IS NOT DISTINCT FROM -b.k
--~ UNKNOWN

-- case: a_null_safe_equality_through_an_inverse_is_definite_for_a_non_null_column
CREATE TABLE a (k INTEGER NOT NULL);
CREATE TABLE b (k INTEGER UNIQUE);
SELECT * FROM a /**ASSERT MANY TO ONE**/ JOIN b ON -b.k IS NOT DISTINCT FROM a.k
--~ PROVED

-- case: a_null_safe_equality_through_an_inverse_matches_nulls_of_a_nullable_column
CREATE TABLE a (k INTEGER);
CREATE TABLE b (k INTEGER UNIQUE);
SELECT * FROM a /**ASSERT MANY TO ONE**/ JOIN b ON -b.k IS NOT DISTINCT FROM a.k
--~ UNKNOWN

-- case: an_outer_join_binds_through_a_function_too
CREATE TABLE a (k INTEGER NOT NULL);
CREATE TABLE b (k INTEGER UNIQUE);
SELECT * FROM a /**ASSERT MANY TO ONE**/ LEFT JOIN b ON b.k = a.k + 1
--~ PROVED

-- case: arithmetic_that_wraps_binds_nothing
-- dialect: sqlite
CREATE TABLE chain (id INTEGER PRIMARY KEY, parent INTEGER UNIQUE);
SELECT * FROM chain AS child /**ASSERT MANY TO ONE**/ JOIN chain AS p ON p.id = child.parent + 1
--~ UNKNOWN
