-- Uniqueness propagated through Filter and Project, with Alias identity for
-- aliases and self-joins.
--
-- Every case here joins against a derived table (`(SELECT ...) AS alias`) or a
-- second occurrence of an already-declared table, rather than a bare table, so
-- these are the scenarios `test_analyze_unique_join.py` does not cover.

-- case: a_filter_preserves_an_existing_unique_set
CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (user_id INTEGER);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN (SELECT * FROM users WHERE id > 0) AS u  --~ PROVED
    ON sessions.user_id = u.id

-- case: projecting_every_member_of_a_unique_set_preserves_it
CREATE TABLE order_items (order_id INTEGER, line_no INTEGER, sku VARCHAR, PRIMARY KEY (order_id, line_no));
CREATE TABLE orders (id INTEGER);

SELECT *
FROM orders
/**ASSERT MANY TO ONE**/ JOIN (SELECT order_id, line_no FROM order_items) AS oi
--~ PROVED
    ON orders.id = oi.order_id AND orders.id = oi.line_no

-- case: renaming_a_projected_unique_column_maps_the_unique_set_to_the_output_name
CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (user_id INTEGER);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN (SELECT id AS uid FROM users) AS u  --~ PROVED
    ON sessions.user_id = u.uid

-- case: dropping_a_required_key_member_is_unknown
CREATE TABLE order_items (order_id INTEGER, line_no INTEGER, sku VARCHAR, PRIMARY KEY (order_id, line_no));
CREATE TABLE orders (id INTEGER);

SELECT *
FROM orders
/**ASSERT MANY TO ONE**/ JOIN (SELECT order_id FROM order_items) AS oi  --~ UNKNOWN
    ON orders.id = oi.order_id

-- case: replacing_a_key_member_with_a_computed_expression_keeps_it_only_if_one_to_one__id_7_outcome_unknown
CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (user_id INTEGER);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN (SELECT id % 7 AS id FROM users) AS u  --~ UNKNOWN
    ON sessions.user_id = u.id

-- case: replacing_a_key_member_with_a_computed_expression_keeps_it_only_if_one_to_one__id_7_outcome_proved
CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (user_id INTEGER);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN (SELECT id + 7 AS id FROM users) AS u  --~ PROVED
    ON sessions.user_id = u.id

-- case: two_aliases_of_the_same_relation_are_separate_occurrences
CREATE TABLE users (id INTEGER PRIMARY KEY, manager_id INTEGER);

SELECT *
FROM users a
/**ASSERT MANY TO ONE**/ JOIN users b  --~ PROVED
    ON a.manager_id = b.id

-- case: a_self_join_stays_unknown_independently_of_a_valid_join_elsewhere
-- Two occurrences of `users`, one validly joined on its unique column and
-- one on a non-unique column: proof of the first must not leak into the
-- second.
CREATE TABLE users (id INTEGER PRIMARY KEY, manager_id INTEGER, name VARCHAR);
CREATE TABLE sessions (user_id INTEGER);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN users a  --~ PROVED
    ON sessions.user_id = a.id
/**ASSERT MANY TO ONE**/ JOIN users b  --~ UNKNOWN
    ON a.manager_id = b.name

-- case: multiple_supported_assertions_all_proved_report_overall_success
-- Every assertion is reported and the overall result succeeds only when
-- all of them do -- UNKNOWN, not just Disproof, must fail it (see the mixed
-- case above), and PROVED across the board must not be short-circuited by
-- checking only the first.
CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (id INTEGER PRIMARY KEY, user_id INTEGER);
CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN users  --~ PROVED
    ON sessions.user_id = users.id
/**ASSERT MANY TO ONE**/ JOIN orders  --~ PROVED
    ON sessions.id = orders.id
