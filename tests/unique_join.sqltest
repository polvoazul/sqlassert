
-- case: declared_unique_set_covered_by_the_join_predicate_is_proved
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);
CREATE TABLE sessions (user_id INTEGER, ts TIMESTAMP);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: join_proof_is_independent_of_equality_operand_order
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);
CREATE TABLE sessions (user_id INTEGER, ts TIMESTAMP);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN users  --~ PROVED
    ON users.id = sessions.user_id

-- case: join_without_a_matching_unique_set_is_unknown_rather_than_disproved
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);
CREATE TABLE sessions (user_id INTEGER, ts TIMESTAMP);

SELECT *
FROM users
/**ASSERT MANY TO ONE**/ JOIN sessions  --~ UNKNOWN
    ON users.id = sessions.user_id

-- case: program_without_markers_declares_no_assertions
SELECT * FROM sessions JOIN users ON sessions.user_id = users.id
--~! undeclared-table
--~! undeclared-table

-- case: more_than_one_root_select_is_an_explicit_program_diagnostic
SELECT 1;
SELECT 2
--~! multiple-root-selects

-- case: omitted_knowledge_behaves_as_empty_knowledge
CREATE TABLE sessions (user_id INTEGER, ts TIMESTAMP);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN users  --~ UNKNOWN
    ON sessions.user_id = users.id
--~! undeclared-table

-- case: unqualified_columns_in_the_on_predicate_resolve_by_name
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);
CREATE TABLE sessions (user_id INTEGER, ts TIMESTAMP);

SELECT * FROM sessions /**ASSERT MANY TO ONE**/ JOIN users ON user_id = id  --~ PROVED

-- case: an_unaliased_subquery_can_be_the_right_side_of_a_unique_join
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);
CREATE TABLE sessions (user_id INTEGER, ts TIMESTAMP);

SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN (SELECT id FROM users)  --~ PROVED
    ON sessions.user_id = id

-- case: an_unqualified_column_is_not_resolved_past_a_source_of_unknown_schema
-- `sessions` is undeclared, so it may have its own `id`; the one visible
-- `id` cannot be assumed to be `users.id`.
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);

SELECT * FROM sessions /**ASSERT MANY TO ONE**/ JOIN users ON user_id = id  --~ UNKNOWN
--~! undeclared-table

-- case: an_ambiguous_unqualified_column_is_not_resolved
-- Both inputs have `id`; the predicate does not bind `users.id`.
CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR);
CREATE TABLE sessions (id INTEGER, user_id INTEGER);

SELECT * FROM sessions /**ASSERT MANY TO ONE**/ JOIN users ON user_id = id  --~ UNKNOWN
