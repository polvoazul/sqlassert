-- Trino semantics the rules depend on (`sqlassert/dialects.py`).
--
-- Arithmetic, CAST and division raise rather than return NULL, and Trino
-- never casts implicitly between text and numbers. `||` and `concat()` are
-- NULL when an operand is, arrays included; `concat_ws()` is not modelled.
-- VARCHAR compares by code point: Trino has no collations. A TIMESTAMP WITH
-- TIME ZONE keeps its zone, so equal instants differ as text. Trino has no key
-- constraints (its CREATE TABLE rejects them), so a key written in Trino SQL
-- is unenforced; NOT NULL is enforced.

-- dialect: trino
CREATE TABLE t (
    id INTEGER NOT NULL, n INTEGER NOT NULL, m INTEGER, s VARCHAR NOT NULL, r VARCHAR, c CHAR(3), d DECIMAL,
    ts TIMESTAMP WITH TIME ZONE, lt TIMESTAMP
);

-- case: arithmetic_of_non_null_operands_is_non_null
SELECT n + 1 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: division_by_a_non_null_value_is_non_null
SELECT n / 2 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: remainder_by_a_non_null_value_is_non_null
SELECT n % 2 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: a_cast_of_a_non_null_value_is_non_null
SELECT CAST(s AS INTEGER) AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: try_cast_may_be_null
SELECT TRY_CAST(s AS INTEGER) AS v FROM t /**ASSERT NOT NULL(v)**/  --~ UNKNOWN

-- case: a_comparison_of_non_null_operands_is_non_null
SELECT n < 2 AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: pipes_of_non_null_operands_are_non_null
SELECT s || 'x' AS v FROM t /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: pipes_reject_a_null_operand
-- Even an array's: `ARRAY[1] || CAST(NULL AS ARRAY(INTEGER))` is NULL.
SELECT o.id AS oid FROM t LEFT JOIN t AS o ON o.id = t.m WHERE o.r || 'x' = 'ax' /**ASSERT NOT NULL(oid)**/
--~ PROVED

-- case: concat_rejects_a_null_argument
SELECT o.id AS oid FROM t LEFT JOIN t AS o ON o.id = t.m WHERE concat(o.r, 'x') = 'ax' /**ASSERT NOT NULL(oid)**/
--~ PROVED

-- case: concat_ws_is_not_modelled
-- It skips a NULL VARCHAR, but `concat_ws(',', CAST(NULL AS ARRAY(VARCHAR)))` is NULL.
SELECT concat_ws(',', r, s) AS v FROM t /**ASSERT NOT NULL(v)**/  --~ UNKNOWN

-- case: varchar_is_compared_by_identity
-- No value equals both 'b' and 'B', so no row is kept.
SELECT r FROM t WHERE r IN ('a', 'b') AND r = 'B' /**ASSERT ENUM(r IN ('a'))**/
--~ PROVED
--~ always-null-column "'r' is always NULL"

-- case: char_is_not_compared_by_identity
-- CHAR ignores trailing spaces when compared.
SELECT c FROM t WHERE c IN ('a', 'b') AND c = 'B' /**ASSERT ENUM(c IN ('a'))**/
--~ UNKNOWN

-- case: a_decimal_without_a_scale_is_compared_by_identity
-- A bare DECIMAL is DECIMAL(38, 0).
SELECT d, CAST(d AS VARCHAR) AS x FROM t /**ASSERT DETERMINES(d -> x)**/  --~ PROVED

-- case: a_zoned_timestamp_is_not_compared_by_identity
-- `TIMESTAMP '2024-01-01 01:00 +01:00' = TIMESTAMP '2024-01-01 00:00 UTC'`,
-- yet they cast to different text.
SELECT ts, CAST(ts AS VARCHAR) AS x FROM t /**ASSERT DETERMINES(ts -> x)**/  --~ UNKNOWN

-- case: a_timestamp_without_a_zone_is_compared_by_identity
SELECT lt, CAST(lt AS VARCHAR) AS x FROM t /**ASSERT DETERMINES(lt -> x)**/  --~ PROVED

-- case: comparing_a_cast_of_a_zoned_timestamp_warns
SELECT id FROM t WHERE CAST(ts AS DATE) = DATE '2024-01-01' /**ASSERT NOT NULL(id)**/  --~ PROVED
--~ zoned-timestamp-cast "CAST(ts AS DATE) is compared"

-- case: comparing_the_zoned_timestamp_itself_does_not_warn
SELECT id FROM t WHERE ts > TIMESTAMP '2024-01-01 00:00:00 UTC' /**ASSERT NOT NULL(id)**/  --~ PROVED

-- case: a_primary_key_is_not_knowledge
-- trust_unenforced_keys: false
CREATE TABLE k (id INTEGER PRIMARY KEY);
--~ unenforced-constraint "trino does not enforce it"
SELECT id FROM k /**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: a_foreign_key_is_not_knowledge
-- trust_unenforced_keys: false
CREATE TABLE k (id INTEGER NOT NULL);
CREATE TABLE o (id INTEGER NOT NULL, k_id INTEGER, FOREIGN KEY (k_id) REFERENCES k (id));
--~ unenforced-constraint "foreign key ('k_id')"
SELECT k_id FROM o /**ASSERT FOREIGN KEY(k_id) REFERENCES k(id)**/  --~ UNKNOWN

-- case: a_primary_key_is_trusted_by_default
-- A Property Declaration (`trust_unenforced_keys` is on by default), never Knowledge.
CREATE TABLE k (id INTEGER PRIMARY KEY);
SELECT id FROM k /**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: not_null_is_enforced
SELECT n FROM t /**ASSERT NOT NULL(n)**/  --~ PROVED

-- case: comparing_arrays_may_be_null
-- `ARRAY[1, NULL] <> ARRAY[1, NULL]` is NULL.
CREATE TABLE a (id INTEGER NOT NULL, x ARRAY(INTEGER) NOT NULL, y ARRAY(INTEGER) NOT NULL, r ROW(f INTEGER) NOT NULL);
SELECT x <> y AS v FROM a /**ASSERT NOT NULL(v)**/  --~ UNKNOWN
--~ composite-comparison "x <> y compares x, which may hold a NULL element"
--~ composite-comparison "x <> y compares y"

-- case: comparing_rows_may_be_null
-- `ROW(1, NULL) = ROW(1, NULL)` is NULL.
CREATE TABLE a (id INTEGER NOT NULL, r ROW(f INTEGER) NOT NULL);
SELECT r < r AS v FROM a /**ASSERT NOT NULL(v)**/  --~ UNKNOWN
--~ composite-comparison

-- case: comparing_arrays_with_declared_non_null_elements_is_non_null
CREATE TABLE a (id INTEGER NOT NULL, x ARRAY(INTEGER) NOT NULL, y ARRAY(INTEGER) NOT NULL);
WITH d AS (SELECT x, y FROM a /**DECLARE NOT NULL ELEMENTS(x, y)**/)
SELECT x <> y AS v FROM d /**ASSERT NOT NULL(v)**/  --~ PROVED

-- case: one_operand_with_declared_elements_is_not_enough
CREATE TABLE a (id INTEGER NOT NULL, x ARRAY(INTEGER) NOT NULL, y ARRAY(INTEGER) NOT NULL);
WITH d AS (SELECT x, y FROM a /**DECLARE NOT NULL ELEMENTS(x)**/)
SELECT x <> y AS v FROM d /**ASSERT NOT NULL(v)**/  --~ UNKNOWN
--~ composite-comparison "compares y"

-- case: declared_elements_pass_through
CREATE TABLE a (id INTEGER NOT NULL, x ARRAY(INTEGER));
WITH d AS (SELECT x FROM a /**DECLARE NOT NULL ELEMENTS(x)**/)
SELECT x FROM d /**ASSERT NOT NULL ELEMENTS(x)**/  --~ PROVED

-- case: elements_are_not_known_without_a_declaration
CREATE TABLE a (id INTEGER NOT NULL, x ARRAY(INTEGER));
SELECT x FROM a /**ASSERT NOT NULL ELEMENTS(x)**/  --~ UNKNOWN

-- case: a_cast_to_an_array_may_hold_a_null_element
SELECT CAST(r AS ARRAY(VARCHAR)) <> CAST(s AS ARRAY(VARCHAR)) AS v FROM t /**ASSERT NOT NULL(v)**/  --~ UNKNOWN
--~ composite-comparison "compares CAST(r AS ARRAY(VARCHAR))"
--~ composite-comparison "compares CAST(s AS ARRAY(VARCHAR))"
