-- A select item computed by a function whose result type the dialect fixes
-- (`DialectSemantics.result_types`) is typed as a column declared with that
-- type: an equality on it binds, and its values compare by identity where the
-- type does. A function whose type follows its arguments stays untyped, and so
-- does every function in a dialect that certifies none.

CREATE TABLE people (name VARCHAR, code VARCHAR, born DATE);
CREATE TABLE badges (code VARCHAR, size INTEGER, issued TIMESTAMP);

-- case: md5_keys_join_as_varchar
WITH keys AS (SELECT DISTINCT md5(name) AS k FROM people),
     wanted AS (SELECT md5(code) AS k FROM badges)
SELECT *
FROM wanted
/**ASSERT MANY TO ONE**/ JOIN keys ON wanted.k = keys.k  --~ PROVED

-- case: length_joins_an_integer_column
WITH sizes AS (SELECT DISTINCT length(name) AS n FROM people)
SELECT *
FROM badges
/**ASSERT MANY TO ONE**/ JOIN sizes ON badges.size = sizes.n  --~ PROVED

-- case: varchar_result_does_not_bind_an_integer
WITH keys AS (SELECT DISTINCT md5(name) AS k FROM people)
SELECT *
FROM badges
/**ASSERT MANY TO ONE**/ JOIN keys ON badges.size = keys.k  --~ UNKNOWN

-- case: date_trunc_follows_its_argument_so_stays_untyped
WITH months AS (SELECT DISTINCT date_trunc('month', born) AS m FROM people)
SELECT *
FROM badges
/**ASSERT MANY TO ONE**/ JOIN months ON badges.issued = months.m  --~ UNKNOWN

-- case: a_dialect_that_claims_no_result_type_leaves_md5_untyped
-- Oracle has no md5 function: SQLGlot parses one, but nothing is claimed.
-- dialect: oracle
WITH keys AS (SELECT DISTINCT md5(name) AS k FROM people),
     wanted AS (SELECT md5(code) AS k FROM badges)
SELECT *
FROM wanted
/**ASSERT MANY TO ONE**/ JOIN keys ON wanted.k = keys.k  --~ UNKNOWN

-- case: postgres_md5_keys_join_as_text
-- dialect: postgres
WITH keys AS (SELECT DISTINCT md5(name) AS k FROM people),
     wanted AS (SELECT md5(code) AS k FROM badges)
SELECT *
FROM wanted
/**ASSERT MANY TO ONE**/ JOIN keys ON wanted.k = keys.k  --~ PROVED

-- case: mysql_hashes_of_non_null_values_are_non_null
-- MySQL claims md5 and sha1 strict and total, but not sha2: its length is free.
-- dialect: mysql
SELECT md5(COALESCE(code, '')) AS k1, sha1(COALESCE(code, '')) AS k2 FROM badges
/**ASSERT NOT NULL(k1, k2)**/  --~ PROVED

-- case: mysql_sha2_of_a_non_null_value_is_not_known_non_null
-- dialect: mysql
SELECT sha2(COALESCE(code, ''), 256) AS k FROM badges
/**ASSERT NOT NULL(k)**/  --~ UNKNOWN

-- case: trino_digests_of_non_null_values_are_non_null
-- dialect: trino
SELECT md5(CAST(COALESCE(code, '') AS VARBINARY)) AS k1, sha256(CAST(COALESCE(code, '') AS VARBINARY)) AS k2 FROM badges
/**ASSERT NOT NULL(k1, k2)**/  --~ PROVED

-- case: a_hash_of_a_coalesced_value_is_never_null
-- dbt's generate_surrogate_key: md5 is strict and total, so the key is
-- non-null exactly when its argument is, and coalesce makes that argument so.
SELECT md5(CAST(COALESCE(CAST(code AS VARCHAR), '_null_') AS VARCHAR)) AS k1,
       sha1(COALESCE(code, '')) AS k2,
       sha256(COALESCE(code, '')) AS k3
FROM badges
/**ASSERT NOT NULL(k1, k2, k3)**/  --~ PROVED

-- case: a_hash_of_a_nullable_value_may_be_null
SELECT md5(code) AS k FROM badges
/**ASSERT NOT NULL(k)**/  --~ UNKNOWN

-- case: sha1_keys_join_as_varchar
WITH keys AS (SELECT DISTINCT sha1(name) AS k FROM people),
     wanted AS (SELECT sha1(code) AS k FROM badges)
SELECT *
FROM wanted
/**ASSERT MANY TO ONE**/ JOIN keys ON wanted.k = keys.k  --~ PROVED
