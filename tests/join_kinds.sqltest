-- A Unique Join Assertion through every join kind.
--
-- A left row appears once per matching right row, or once padded, whatever the
-- kind: RIGHT and FULL joins pad right rows on but never repeat a left row more
-- than its matches do, so the right side's Unique Set proves them as it proves
-- INNER and LEFT joins. A CROSS join is an ON with no conjuncts: unique only when
-- the right input has at most one row. SEMI and ANTI joins keep or drop each
-- left row whole and output no right row: no cardinality marker applies to them.

CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (user_id INTEGER);

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__join_users_on_sessions_user_id_users_id
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__inner_join_users_on_sessions_user_id_users_id
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ INNER JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__left_join_users_on_sessions_user_id_users_id
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ LEFT JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__p4
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ LEFT OUTER JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__right_join_users_on_sessions_user_id_users_id
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ RIGHT JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__full_join_users_on_sessions_user_id_users_id
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ FULL JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__p7
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ FULL OUTER JOIN users  --~ PROVED
    ON sessions.user_id = users.id

-- case: a_join_against_a_primary_key_is_proved_whatever_its_kind__cross_join_select_count_as_n_from_users_as_c
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ CROSS JOIN (SELECT count(*) AS n FROM users) AS c  --~ PROVED

-- case: unproved_joins_stay_unknown__right_without_a_key
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ RIGHT JOIN sessions AS s2  --~ UNKNOWN
    ON sessions.user_id = s2.user_id

-- case: unproved_joins_stay_unknown__full_without_a_key
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ FULL JOIN sessions AS s2  --~ UNKNOWN
    ON sessions.user_id = s2.user_id

-- case: unproved_joins_stay_unknown__cross_onto_many_rows
SELECT * FROM sessions /**ASSERT MANY TO ONE**/ CROSS JOIN users  --~ UNKNOWN

-- case: unproved_joins_stay_unknown__positional
SELECT * FROM sessions /**ASSERT MANY TO ONE**/ POSITIONAL JOIN users  --~ UNKNOWN

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__unique_semi_join
SELECT *
FROM sessions
/**ASSERT UNIQUE**/ SEMI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__unique_anti_join
SELECT *
FROM sessions
/**ASSERT UNIQUE**/ ANTI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__unique_right_semi_join
SELECT *
FROM sessions
/**ASSERT UNIQUE**/ RIGHT
--~ cardinality-on-filtering-join
SEMI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__unique_right_anti_join
SELECT *
FROM sessions
/**ASSERT UNIQUE**/ RIGHT
--~ cardinality-on-filtering-join
ANTI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__many_to_one_semi_join
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ SEMI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__many_to_one_anti_join
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ ANTI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__many_to_one_right_semi_join
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ RIGHT
--~ cardinality-on-filtering-join
SEMI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__many_to_one_right_anti_join
SELECT *
FROM sessions
/**ASSERT MANY TO ONE**/ RIGHT
--~ cardinality-on-filtering-join
ANTI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_many_semi_join
SELECT *
FROM sessions
/**ASSERT ONE TO MANY**/ SEMI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_many_anti_join
SELECT *
FROM sessions
/**ASSERT ONE TO MANY**/ ANTI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_many_right_semi_join
SELECT *
FROM sessions
/**ASSERT ONE TO MANY**/ RIGHT
--~ cardinality-on-filtering-join
SEMI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_many_right_anti_join
SELECT *
FROM sessions
/**ASSERT ONE TO MANY**/ RIGHT
--~ cardinality-on-filtering-join
ANTI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_one_semi_join
SELECT *
FROM sessions
/**ASSERT ONE TO ONE**/ SEMI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_one_anti_join
SELECT *
FROM sessions
/**ASSERT ONE TO ONE**/ ANTI JOIN users
--~ cardinality-on-filtering-join
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_one_right_semi_join
SELECT *
FROM sessions
/**ASSERT ONE TO ONE**/ RIGHT
--~ cardinality-on-filtering-join
SEMI JOIN users
    ON sessions.user_id = users.id

-- case: a_cardinality_marker_on_a_semi_or_anti_join_is_rejected__one_to_one_right_anti_join
SELECT *
FROM sessions
/**ASSERT ONE TO ONE**/ RIGHT
--~ cardinality-on-filtering-join
ANTI JOIN users
    ON sessions.user_id = users.id

-- case: a_cross_join_onto_one_row_keeps_the_left_key
SELECT u.id
FROM users AS u
CROSS JOIN (SELECT count(*) AS n FROM sessions) AS c
/**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: a_right_join_does_not_keep_the_left_key
SELECT u.id, s.user_id
FROM users AS u
RIGHT JOIN sessions AS s
    ON u.id = s.user_id
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: a_positional_join_pads_both_sides
CREATE TABLE a (x INTEGER NOT NULL);
CREATE TABLE b (y INTEGER NOT NULL);
SELECT x, y FROM a POSITIONAL JOIN b /**ASSERT NOT NULL(x)**/  --~ UNKNOWN
/**ASSERT NOT NULL(y)**/  --~ UNKNOWN

-- A FULL join's merged key column. Each `a` row matches at most one `b` row on
-- a key of both, and the other way round, so each key value is in at most one
-- output row: a matched pair, an `a`-only row or a `b`-only row. A row with a NULL
-- key part is unmatched and its merged column is NULL, which a Unique Set
-- allows. The merged column is coalesce(a.k, b.k): USING's, or written out.

-- case: the_merged_using_column_of_a_full_join_on_keys_is_unique
CREATE TABLE a (k INTEGER PRIMARY KEY, x INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, y INTEGER);

SELECT k FROM a FULL JOIN b USING (k) /**ASSERT UNIQUE(k)**/  --~ PROVED
/**ASSERT NOT NULL UNIQUE(k)**/  --~ PROVED

-- case: the_merged_column_is_unique_when_the_keys_are_nullable_unique_constraints
CREATE TABLE a (k INTEGER UNIQUE);
CREATE TABLE b (k INTEGER UNIQUE);

SELECT k FROM a FULL JOIN b USING (k) /**ASSERT UNIQUE(k)**/  --~ PROVED
/**ASSERT NOT NULL UNIQUE(k)**/  --~ UNKNOWN

-- case: the_coalesce_written_out_is_unique
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k = b.k /**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_coalesce_is_unique_with_its_arguments_and_the_equality_the_other_way_round
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

SELECT COALESCE(b.k, a.k) AS k FROM a FULL JOIN b ON b.k = a.k /**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_merged_column_is_unique_beside_other_columns_and_a_where
CREATE TABLE a (k INTEGER PRIMARY KEY, x INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, y INTEGER);

SELECT k, a.x, b.y FROM a FULL JOIN b USING (k) WHERE a.x > 0 OR b.y > 0 /**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_merged_column_is_unique_through_a_cte
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

WITH merged AS (SELECT k FROM a FULL JOIN b USING (k))
SELECT k FROM merged /**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_merged_column_is_unique_across_integer_widths
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k BIGINT PRIMARY KEY);

SELECT k FROM a FULL JOIN b USING (k) /**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_merged_columns_of_a_composite_key_are_unique_together
CREATE TABLE a (k1 INTEGER, k2 INTEGER, x INTEGER, PRIMARY KEY (k1, k2));
CREATE TABLE b (k1 INTEGER, k2 INTEGER, y INTEGER, PRIMARY KEY (k1, k2));

SELECT k1, k2 FROM a FULL JOIN b USING (k1, k2) /**ASSERT UNIQUE(k1, k2)**/  --~ PROVED
/**ASSERT UNIQUE(k1)**/  --~ UNKNOWN
/**ASSERT UNIQUE(k2)**/  --~ UNKNOWN

-- case: a_composite_key_written_out_is_unique_when_every_pair_is_selected
CREATE TABLE a (k1 INTEGER, k2 INTEGER, PRIMARY KEY (k1, k2));
CREATE TABLE b (k1 INTEGER, k2 INTEGER, PRIMARY KEY (k1, k2));

SELECT COALESCE(a.k1, b.k1) AS m1, COALESCE(a.k2, b.k2) AS m2
FROM a FULL JOIN b ON a.k1 = b.k1 AND b.k2 = a.k2 /**ASSERT UNIQUE(m1, m2)**/  --~ PROVED

-- IS NOT DISTINCT FROM pairs match NULL to NULL as well, and a NULL merges to
-- the NULL a Unique Set allows; a non-NULL value matches as with `=`.
-- case: the_coalesce_is_unique_on_is_not_distinct_from_pairs
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k IS NOT DISTINCT FROM b.k /**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_coalesce_is_unique_on_is_not_distinct_from_with_nullable_keys
CREATE TABLE a (k INTEGER UNIQUE);
CREATE TABLE b (k INTEGER UNIQUE);

SELECT COALESCE(b.k, a.k) AS k FROM a FULL JOIN b ON b.k IS NOT DISTINCT FROM a.k /**ASSERT UNIQUE(k)**/  --~ PROVED
/**ASSERT NOT NULL UNIQUE(k)**/  --~ UNKNOWN

-- case: a_composite_key_is_unique_on_equal_and_is_not_distinct_from_pairs
CREATE TABLE a (k1 INTEGER, k2 INTEGER, PRIMARY KEY (k1, k2));
CREATE TABLE b (k1 INTEGER, k2 INTEGER, PRIMARY KEY (k1, k2));

SELECT COALESCE(a.k1, b.k1) AS m1, COALESCE(a.k2, b.k2) AS m2
FROM a FULL JOIN b ON a.k1 IS NOT DISTINCT FROM b.k1 AND b.k2 = a.k2 /**ASSERT UNIQUE(m1, m2)**/  --~ PROVED

-- case: the_merged_column_is_unknown_when_is_not_distinct_from_has_another_conjunct
CREATE TABLE a (k INTEGER PRIMARY KEY, x INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, y INTEGER);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k IS NOT DISTINCT FROM b.k AND a.x = b.y /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: the_merged_column_is_unknown_when_is_not_distinct_from_has_a_filter_conjunct
CREATE TABLE a (k INTEGER PRIMARY KEY, x INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, y INTEGER);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k IS NOT DISTINCT FROM b.k AND a.x > 0 /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: the_merged_column_is_unknown_when_is_not_distinct_from_meets_a_key_of_one_input
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k IS NOT DISTINCT FROM b.k /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: the_merged_column_is_unknown_when_is_not_distinct_from_is_not_exact
CREATE TABLE a (k DOUBLE PRIMARY KEY);
CREATE TABLE b (k DOUBLE PRIMARY KEY);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k IS NOT DISTINCT FROM b.k /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- A key of one input leaves the other input's rows repeating a key value.
-- case: the_merged_column_is_unknown_unless_both_inputs_have_the_key
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER);

SELECT k FROM a FULL JOIN b USING (k) /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- Another ON conjunct leaves an `a` row and a `b` row of one key value both
-- unmatched, so two output rows share it.
-- case: the_merged_column_is_unknown_when_on_has_another_conjunct
CREATE TABLE a (k INTEGER PRIMARY KEY, x INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, y INTEGER);

SELECT k FROM a FULL JOIN b ON a.k = b.k AND a.x = b.y /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: the_merged_column_is_unknown_when_on_has_a_filter_conjunct
CREATE TABLE a (k INTEGER PRIMARY KEY, x INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, y INTEGER);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k = b.k AND a.x > 0 /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- A pair of the ON the select does not merge is one more thing two rows may differ on.
-- case: the_merged_column_is_unknown_when_a_pair_of_on_is_not_merged
CREATE TABLE a (k INTEGER PRIMARY KEY, j INTEGER);
CREATE TABLE b (k INTEGER PRIMARY KEY, j INTEGER);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k = b.k AND a.j = b.j /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: a_coalesce_with_a_constant_is_unknown
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

SELECT COALESCE(a.k, 0) AS k0 FROM a FULL JOIN b ON a.k = b.k /**ASSERT UNIQUE(k0)**/  --~ UNKNOWN

-- case: a_coalesce_of_three_arguments_is_unknown
CREATE TABLE a (k INTEGER PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

SELECT COALESCE(a.k, b.k, 0) AS k3 FROM a FULL JOIN b ON a.k = b.k /**ASSERT UNIQUE(k3)**/  --~ UNKNOWN

-- A comparison that is not exact (a float, text beside a number) matches rows
-- the keys do not tell apart, and the coalesced value is not one of them.
-- case: the_merged_column_is_unknown_when_the_comparison_is_not_exact
CREATE TABLE a (k DOUBLE PRIMARY KEY);
CREATE TABLE b (k DOUBLE PRIMARY KEY);

SELECT k FROM a FULL JOIN b USING (k) /**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: the_merged_column_is_unknown_when_a_text_key_meets_a_number
CREATE TABLE a (k VARCHAR PRIMARY KEY);
CREATE TABLE b (k INTEGER PRIMARY KEY);

SELECT COALESCE(a.k, b.k) AS k FROM a FULL JOIN b ON a.k = b.k /**ASSERT UNIQUE(k)**/  --~ UNKNOWN
