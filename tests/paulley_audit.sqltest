-- Issue 35: one case per rule of the Paulley audit table.
--
-- `docs/functional-dependencies.md`, section "Paulley audit", lists every rule
-- of Paulley 2000 §2.5.2 and §3.1–3.2 with its status. Each implemented row
-- names a case here by its ID; a rule sqlassert must not apply has a case that
-- stays UNKNOWN (suffix `-`, written `_minus` in a case name). The soundness
-- oracle judges every PROVED case.

CREATE TABLE t (id INTEGER PRIMARY KEY, a INTEGER, b INTEGER, c INTEGER, d INTEGER NOT NULL, e INTEGER NOT NULL);
CREATE TABLE u (k INTEGER PRIMARY KEY, x INTEGER, y INTEGER NOT NULL, z INTEGER, UNIQUE (x));
CREATE TABLE v (w INTEGER, q INTEGER);
CREATE TABLE labels (name VARCHAR, id INTEGER);

-- case: A1
SELECT a, b FROM t /**ASSERT DETERMINES(a, b -> a)**/  --~ PROVED

-- case: A10
SELECT id, a, b FROM t WHERE a = id /**ASSERT DETERMINES(a -> b)**/  --~ PROVED

-- case: A11
WITH s AS (SELECT * FROM t /**DECLARE DETERMINES(a -> d)**/
/**DECLARE DETERMINES(d -> c)**/) SELECT a, d, c FROM s
/**ASSERT DETERMINES(a -> c)**/  --~ PROVED

-- case: A11_minus
WITH s AS (SELECT * FROM t /**DECLARE DETERMINES(a -> b)**/
/**DECLARE DETERMINES(b -> c)**/) SELECT a, b, c FROM s
/**ASSERT DETERMINES(a -> c)**/  --~ UNKNOWN

-- case: A2
SELECT id, a, b FROM t /**ASSERT DETERMINES(id, a -> b)**/  --~ PROVED

-- case: A3
SELECT x, z, k FROM u /**ASSERT DETERMINES(x, z -> k)**/  --~ PROVED

-- case: A4
SELECT id, a, b FROM t /**ASSERT DETERMINES(id -> a, b)**/  --~ PROVED

-- case: A5
SELECT x, k, z FROM u /**ASSERT DETERMINES(x -> k, z)**/  --~ PROVED

-- case: A6
WITH s AS (SELECT * FROM t /**DECLARE DETERMINES(d -> a, b)**/) SELECT d, a, b FROM s
/**ASSERT DETERMINES(d -> b)**/  --~ PROVED

-- case: A7
WITH s AS (SELECT * FROM t /**DECLARE DETERMINES(a -> b, c)**/) SELECT a, b, c FROM s
/**ASSERT DETERMINES(a -> c)**/  --~ PROVED

-- case: A8
SELECT id, a FROM t /**ASSERT DETERMINES(id -> a)**/  --~ PROVED

-- case: A9
SELECT x, z FROM u WHERE x IS NOT NULL /**ASSERT NOT NULL UNIQUE(x)**/  --~ PROVED

-- case: C1
SELECT t.id, t.a, v.w FROM t CROSS JOIN v /**ASSERT DETERMINES(id -> a)**/  --~ PROVED

-- case: C2
SELECT t.id, u.k FROM t CROSS JOIN u /**ASSERT UNIQUE(id, k)**/  --~ PROVED

-- case: C2_minus
SELECT t.id, u.k FROM t CROSS JOIN u /**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: C3
SELECT t.id FROM t CROSS JOIN (SELECT count(*) AS n FROM v) AS c /**ASSERT UNIQUE(id)**/
--~ PROVED

-- case: D1
WITH q AS (SELECT id, a FROM t EXCEPT ALL SELECT id, a FROM t WHERE a = 1)
SELECT id, a
FROM q
/**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: E1
SELECT a, c FROM t WHERE a = b AND b = c /**ASSERT DETERMINES(a -> c)**/  --~ PROVED

-- case: E2
SELECT a, b FROM t WHERE a = b /**ASSERT DETERMINES(b -> a)**/  --~ PROVED

-- case: E5
SELECT t.a, u.z FROM t LEFT JOIN u ON u.z = t.a /**ASSERT DETERMINES(z -> a)**/
--~ PROVED

-- case: E6
SELECT t.b, u.z
FROM t
LEFT JOIN u
    ON u.z = t.a
WHERE t.a = t.b
/**ASSERT DETERMINES(z -> b)**/  --~ PROVED

-- case: E6_minus
SELECT t.a, v.w
FROM t
LEFT JOIN u
    ON u.z = t.a
LEFT JOIN v
    ON v.w = u.z
/**ASSERT DETERMINES(w -> a)**/  --~ UNKNOWN

-- case: F1
SELECT t.id, t.a, u.k FROM t FULL JOIN u ON u.k = t.a /**ASSERT DETERMINES(id -> a)**/
--~ PROVED

-- case: F1_minus
SELECT t.b, r.q
FROM t
FULL JOIN (SELECT * FROM v WHERE q = 1) AS r
    ON r.w = t.a
/**ASSERT DETERMINES(b -> q)**/  --~ UNKNOWN

-- case: F1_left
SELECT s.b, u.k
FROM (SELECT * FROM t WHERE b = 1) AS s
FULL JOIN u
    ON u.k = s.a
/**ASSERT DETERMINES(k -> b)**/  --~ UNKNOWN

-- case: F3
SELECT t.id, u.k FROM t FULL JOIN u ON u.k = t.a /**ASSERT UNIQUE(id, k)**/  --~ PROVED

-- case: F3_minus
SELECT t.id, u.z FROM t FULL JOIN u ON u.z = t.a /**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: F5_minus
SELECT t.b, u.k FROM t FULL JOIN u ON u.k = t.a AND t.b = 1 /**ASSERT ENUM(b IN (1))**/
--~ UNKNOWN

-- case: F6
SELECT t.b, r.w, r.q
FROM t
FULL JOIN (SELECT * FROM v WHERE q = w) AS r
    ON r.w = t.a
/**ASSERT DETERMINES(w -> q)**/  --~ PROVED

-- case: F8
SELECT t.d
FROM t
FULL JOIN u
    ON u.k = t.a
WHERE t.id IS NOT NULL
/**ASSERT NOT NULL(d)**/  --~ PROVED

-- case: F8_minus
SELECT t.d FROM t FULL JOIN u ON u.k = t.a /**ASSERT NOT NULL(d)**/  --~ UNKNOWN

-- case: G1
SELECT id, a, count(*) AS n FROM t GROUP BY id, a /**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: G2
SELECT a, a + 1 AS k, count(*) AS n FROM t GROUP BY a, a + 1 /**ASSERT UNIQUE(a)**/
--~ PROVED

-- case: G3
SELECT a, b, count(*) AS n FROM t GROUP BY a, b /**ASSERT UNIQUE(a, b)**/  --~ PROVED

-- case: G3e
SELECT count(*) AS n, max(a) AS m FROM t /**ASSERT UNIQUE(m)**/  --~ PROVED

-- case: G4
SELECT a, count(*) AS n, sum(b) AS s
FROM t
GROUP BY a
/**ASSERT DETERMINES(a -> n, s)**/  --~ PROVED

-- case: I1
WITH q AS (SELECT id, a FROM t INTERSECT ALL SELECT id, a FROM t WHERE a = 1)
SELECT id, a
FROM q
/**ASSERT DETERMINES(id -> a)**/  --~ PROVED

-- case: I2
WITH q AS (SELECT id FROM t INTERSECT ALL SELECT a FROM t)
SELECT id
FROM q
/**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: I3
WITH q AS (SELECT x FROM u INTERSECT ALL SELECT d FROM t)
SELECT x
FROM q
/**ASSERT NOT NULL UNIQUE(x)**/  --~ PROVED

-- case: L1
SELECT t.id, t.a, u.z FROM t LEFT JOIN u ON u.z = t.a /**ASSERT DETERMINES(id -> a)**/
--~ PROVED

-- case: L10_minus
SELECT t.a, u.z FROM t LEFT JOIN u ON u.z = t.a /**ASSERT NOT NULL(z)**/  --~ UNKNOWN

-- case: L11_minus
SELECT t.b FROM t LEFT JOIN u ON u.z = t.a AND t.b = 1 /**ASSERT ENUM(b IN (1))**/
--~ UNKNOWN

-- case: L15
SELECT u.y
FROM t
LEFT JOIN u
    ON u.z = t.a
WHERE u.k IS NOT NULL
/**ASSERT NOT NULL(y)**/  --~ PROVED

-- case: L15_minus
SELECT u.y FROM t LEFT JOIN u ON u.z = t.a /**ASSERT NOT NULL(y)**/  --~ UNKNOWN

-- case: L2
SELECT t.a, u.k, u.y FROM t LEFT JOIN u ON u.k = t.a /**ASSERT DETERMINES(a -> y)**/
--~ PROVED

-- case: L3
SELECT t.b, r.w, r.q
FROM t
LEFT JOIN (SELECT * FROM v WHERE q = w) AS r
    ON r.w = t.a
/**ASSERT DETERMINES(w -> q)**/  --~ PROVED

-- case: L4
SELECT t.a, u.x, u.k FROM t LEFT JOIN u ON u.x = t.a /**ASSERT DETERMINES(x -> k)**/
--~ PROVED

-- case: L5
SELECT u.x, u.z
FROM t
LEFT JOIN u
    ON u.z = t.a AND u.x = u.z
/**ASSERT DETERMINES(x -> z)**/  --~ PROVED

-- case: L6
SELECT t.a, u.x
FROM t
LEFT JOIN u
    ON u.z = t.a AND u.x = 5
/**ASSERT DETERMINES(a -> x)**/  --~ PROVED

-- case: L6_minus
SELECT t.b, u.x
FROM t
LEFT JOIN u
    ON u.z = t.a AND u.x = 5
/**ASSERT DETERMINES(b -> x)**/  --~ UNKNOWN

-- case: L7
SELECT t.id, u.k FROM t LEFT JOIN u ON u.z = t.a /**ASSERT UNIQUE(id, k)**/  --~ PROVED

-- case: L7_minus
SELECT t.id, u.k FROM t LEFT JOIN u ON u.z = t.a /**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: L8
SELECT t.a, u.x, u.k FROM t LEFT JOIN u ON u.z = t.a /**ASSERT DETERMINES(x -> k)**/
--~ PROVED

-- case: L9_minus
SELECT t.b, r.q
FROM t
LEFT JOIN (SELECT * FROM v WHERE q = 1) AS r
    ON r.w = t.a
/**ASSERT DETERMINES(b -> q)**/  --~ UNKNOWN

-- case: P1
SELECT a, b FROM t WHERE a = id /**ASSERT UNIQUE(a)**/  --~ PROVED

-- case: P2
SELECT id, a * 2 AS k FROM t /**ASSERT DETERMINES(id -> k)**/  --~ PROVED

-- case: P3
SELECT DISTINCT a, b FROM t /**ASSERT UNIQUE(a, b)**/  --~ PROVED

-- case: R1
SELECT id, a FROM t WHERE b = 1 /**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: R11
SELECT a, b, c FROM t WHERE a = b AND c + 1 > 0 /**ASSERT NOT NULL(a, b, c)**/
--~ PROVED

-- case: R12
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM v WHERE v.w = t.a) /**ASSERT NOT NULL(a)**/
--~ PROVED

-- case: R13
SELECT a FROM t WHERE a = 1 OR a = 2 /**ASSERT ENUM(a IN (1, 2))**/  --~ PROVED

-- case: R2
WITH s AS (SELECT * FROM t /**DECLARE DETERMINES(a -> b)**/
/**DECLARE DETERMINES(b -> c)**/) SELECT a, b, c FROM s WHERE b IS NOT NULL
/**ASSERT DETERMINES(a -> c)**/  --~ PROVED

-- case: R4
SELECT a, b FROM t WHERE b = a + 1 /**ASSERT DETERMINES(a -> b)**/  --~ PROVED

-- case: R4_minus
SELECT a, b FROM t WHERE b = a % 2 /**ASSERT DETERMINES(b -> a)**/  --~ UNKNOWN

-- case: R5
SELECT a, b FROM t WHERE a = b /**ASSERT DETERMINES(a -> b)**/  --~ PROVED

-- case: R7
SELECT a FROM t WHERE a IS NOT NULL /**ASSERT NOT NULL(a)**/  --~ PROVED

-- case: R8
SELECT a, b FROM t WHERE a IS NULL /**ASSERT DETERMINES(b -> a)**/  --~ PROVED

-- case: S1
SELECT id, a FROM t /**ASSERT NOT NULL UNIQUE(id)**/  --~ PROVED

-- case: S1_minus
CREATE TABLE w (m INTEGER);
CREATE UNIQUE INDEX wm ON w (m);
SELECT m FROM w /**ASSERT NOT NULL UNIQUE(m)**/  --~ UNKNOWN

-- case: S2
SELECT x, z FROM u /**ASSERT UNIQUE(x)**/  --~ PROVED

-- case: S2_minus
SELECT x, z FROM u /**ASSERT NOT NULL UNIQUE(x)**/  --~ UNKNOWN

-- case: S3
SELECT a, b FROM t WHERE a = 5 AND b = 6 /**ASSERT DETERMINES(a -> b)**/  --~ PROVED

-- case: S4
SELECT a, a + 1 AS k FROM t /**ASSERT DETERMINES(a -> k)**/  --~ PROVED

-- case: U1_minus
WITH q AS (SELECT id, a FROM t UNION ALL SELECT id, b FROM t)
SELECT id, a
FROM q
/**ASSERT DETERMINES(id -> a)**/  --~ UNKNOWN

-- case: U3
WITH q AS (SELECT a, b FROM t UNION SELECT c, d FROM t)
SELECT a, b
FROM q
/**ASSERT UNIQUE(a, b)**/  --~ PROVED

-- case: E4
SELECT t.a, u.z FROM t LEFT JOIN u ON u.z = t.a AND u.z = 5 WHERE u.z IS NOT NULL
/**ASSERT ENUM(a IN (5))**/  --~ PROVED

-- case: E4_foreign_key
-- Foreign Key stand-ins cross the strengthened equality too.
CREATE TABLE r (z INTEGER PRIMARY KEY);
CREATE TABLE w (z INTEGER REFERENCES r (z));
SELECT t.a, w.z FROM t LEFT JOIN w ON w.z = t.a WHERE w.z IS NOT NULL
/**ASSERT FOREIGN KEY(a) REFERENCES r(z)**/  --~ PROVED

-- case: E4_foreign_key_minus
-- Without the filter, an unmatched row keeps an a that need not be in r.
CREATE TABLE r (z INTEGER PRIMARY KEY);
CREATE TABLE w (z INTEGER REFERENCES r (z));
SELECT t.a, w.z FROM t LEFT JOIN w ON w.z = t.a
/**ASSERT FOREIGN KEY(a) REFERENCES r(z)**/  --~ UNKNOWN

-- case: E4_minus
-- The filter must make the padded column non-null; t.b says nothing about padding.
SELECT t.a, u.z FROM t LEFT JOIN u ON u.z = t.a AND u.z = 5 WHERE t.b IS NOT NULL
/**ASSERT ENUM(a IN (5))**/  --~ UNKNOWN

-- case: L14
SELECT u.z FROM t LEFT JOIN u ON u.z = t.a WHERE t.a = 5
/**ASSERT ENUM(z IN (5))**/  --~ PROVED

-- case: L14_minus
SELECT t.a FROM t LEFT JOIN u ON u.z = t.a AND u.z = 5
/**ASSERT ENUM(a IN (5))**/  --~ UNKNOWN

-- case: L13
SELECT u.x FROM t LEFT JOIN u ON u.x = u.z AND u.z = 3
/**ASSERT ENUM(x IN (3))**/  --~ PROVED

-- case: L13_full_minus
-- A full join's right-only rows are unconstrained by ON.
SELECT u.x FROM t FULL JOIN u ON u.x = u.z AND u.z = 3
/**ASSERT ENUM(x IN (3))**/  --~ UNKNOWN

-- case: R9
SELECT id, name FROM labels WHERE name LIKE 'example'
/**ASSERT DETERMINES(id -> name)**/  --~ PROVED

-- case: R9_minus
SELECT id, name FROM labels WHERE name LIKE 'ex_mple'
/**ASSERT DETERMINES(id -> name)**/  --~ UNKNOWN

-- case: R9_escape
SELECT id, name FROM labels WHERE name LIKE 'example' ESCAPE 'e'
/**ASSERT DETERMINES(id -> name)**/  --~ UNKNOWN

-- case: R9_case_insensitive_minus
-- dialect: mysql
-- MySQL's default collation ignores case, which LIKE and = treat alike only per collation.
SELECT id, name FROM labels WHERE name LIKE 'example'
/**ASSERT DETERMINES(id -> name)**/  --~ UNKNOWN

-- case: R9_char_minus
-- dialect: postgres
-- CHAR pads: = ignores trailing spaces, LIKE does not.
CREATE TABLE codes (id INTEGER, code CHAR(10));
SELECT id, code FROM codes WHERE code LIKE 'ab'
/**ASSERT DETERMINES(id -> code)**/  --~ UNKNOWN

-- case: R9_through_union_minus
-- dialect: postgres
-- The right input's CHAR values reach the UNION column the left input's type names.
CREATE TABLE codes (id INTEGER, code CHAR(10));
WITH q AS (SELECT id, name FROM labels UNION ALL SELECT id, code FROM codes)
SELECT id, name FROM q WHERE name LIKE 'example'
/**ASSERT DETERMINES(id -> name)**/  --~ UNKNOWN

-- case: I1_right
WITH q AS (
    SELECT a, b FROM t
    INTERSECT ALL
    SELECT x, z FROM u
)
SELECT a, b FROM q /**ASSERT DETERMINES(a -> b)**/  --~ PROVED

-- case: I1_coercion
WITH q AS (
    SELECT name, id FROM labels
    INTERSECT ALL
    SELECT x, z FROM u
)
SELECT name, id FROM q /**ASSERT DETERMINES(name -> id)**/  --~ UNKNOWN

-- case: I1_double_minus
-- DOUBLE equality is not identity (0.0 = -0.0): the right input's key stays there.
CREATE TABLE fl (p DOUBLE, q INTEGER);
CREATE TABLE fr (p DOUBLE PRIMARY KEY, q INTEGER);
WITH s AS (SELECT p, q FROM fl INTERSECT ALL SELECT p, q FROM fr)
SELECT p, q FROM s /**ASSERT DETERMINES(p -> q)**/  --~ UNKNOWN

-- case: I1_case_insensitive_minus
-- dialect: mysql
-- 'a' = 'A' under MySQL's default collation: the right input's key stays there.
CREATE TABLE ml (s VARCHAR(10), n INTEGER);
CREATE TABLE mr (s VARCHAR(10) PRIMARY KEY, n INTEGER);
WITH s AS (SELECT s, n FROM ml INTERSECT ALL SELECT s, n FROM mr)
SELECT s, n FROM s /**ASSERT DETERMINES(s -> n)**/  --~ UNKNOWN

-- case: U2
WITH q AS (
    SELECT a, b, c FROM t WHERE a = b AND c = 5
    UNION ALL
    SELECT a, b, c FROM t WHERE b = a AND c = 5
)
SELECT a, b, c FROM q
/**ASSERT DETERMINES(a -> b, c)**/  --~ PROVED

-- case: U2_disjoint
WITH q AS (
    SELECT id, a, b FROM t WHERE a = 10
    UNION ALL
    SELECT id, a, b FROM t WHERE a = 20
)
SELECT id, a, b FROM q
/**ASSERT DETERMINES(id, a -> b)**/  --~ PROVED
/**ASSERT UNIQUE(id, a)**/  --~ PROVED
/**ASSERT DETERMINES(id -> a)**/  --~ PROVED

-- case: U2_different_constants_minus
-- One id occurs in both inputs, with c = 5 in one and 6 in the other.
WITH q AS (
    SELECT id, 5 AS c FROM t
    UNION ALL
    SELECT id, 6 AS c FROM t
)
SELECT id, c FROM q
/**ASSERT DETERMINES(id -> c)**/  --~ UNKNOWN
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN
/**ASSERT UNIQUE(id, c)**/  --~ PROVED

-- case: U2_shared_table_padded
-- An id picks one t row in both inputs; a padded row is NULL on id and a alike.
WITH q AS (
    SELECT t.id, t.a FROM u LEFT JOIN t ON t.id = u.k
    UNION ALL
    SELECT id, a FROM t
)
SELECT id, a FROM q
/**ASSERT DETERMINES(id -> a)**/  --~ PROVED
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: U2_shared_table_different_columns_minus
WITH q AS (
    SELECT id, a FROM t
    UNION ALL
    SELECT id, b FROM t
)
SELECT id, a FROM q
/**ASSERT DETERMINES(id -> a)**/  --~ UNKNOWN

-- case: U2_shared_table_self_join_minus
-- id and a come from different rows of t in the first input.
WITH q AS (
    SELECT t1.id, t2.a FROM t AS t1 CROSS JOIN t AS t2
    UNION ALL
    SELECT id, a FROM t
)
SELECT id, a FROM q
/**ASSERT DETERMINES(id -> a)**/  --~ UNKNOWN

-- case: U2_shared_cte_self_join_minus
-- One CTE, two references: two rows of t again.
WITH c AS (SELECT id, a FROM t), q AS (
    SELECT c1.id, c2.a FROM c AS c1 CROSS JOIN c AS c2
    UNION ALL
    SELECT id, a FROM t
)
SELECT id, a FROM q
/**ASSERT DETERMINES(id -> a)**/  --~ UNKNOWN

-- case: U2_shared_table_nullable_key
-- x is UNIQUE but nullable: rows with a NULL x are exempt from DETERMINES, and
-- each non-null x occurs once per input.
WITH q AS (
    SELECT x, y FROM u
    UNION ALL
    SELECT x, y FROM u
)
SELECT x, y FROM q
/**ASSERT DETERMINES(x -> y)**/  --~ PROVED
/**ASSERT UNIQUE(x)**/  --~ UNKNOWN

-- case: U2_null_tag_minus
-- A NULL tag in one input separates nothing on its own: id repeats across inputs.
WITH q AS (
    SELECT id, NULL AS tag FROM t
    UNION ALL
    SELECT id, 1 AS tag FROM t
)
SELECT id, tag FROM q
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: U2_string_tag
CREATE TABLE tagged (id INTEGER PRIMARY KEY, tag VARCHAR(10));
WITH q AS (
    SELECT id, tag FROM tagged WHERE tag = 'a'
    UNION ALL
    SELECT id, tag FROM tagged WHERE tag = 'A'
)
SELECT id, tag FROM q
/**ASSERT UNIQUE(id, tag)**/  --~ PROVED

-- case: U2_string_tag_case_insensitive_minus
-- dialect: mysql
-- 'a' = 'A' under MySQL's default collation: the tag does not separate the inputs.
CREATE TABLE tagged (id INTEGER PRIMARY KEY, tag VARCHAR(10));
WITH q AS (
    SELECT id, tag FROM tagged WHERE tag = 'a'
    UNION ALL
    SELECT id, tag FROM tagged WHERE tag = 'A'
)
SELECT id, tag FROM q
/**ASSERT UNIQUE(id, tag)**/  --~ UNKNOWN

-- case: F2
SELECT t.a, u.z FROM t FULL JOIN u ON u.z = t.a
/**ASSERT DETERMINES(a -> z)**/  --~ PROVED
/**ASSERT DETERMINES(z -> a)**/  --~ PROVED

-- case: F2_extra_on
SELECT t.a, t.b, u.z FROM t FULL JOIN u ON u.z = t.a AND t.b = 1
/**ASSERT DETERMINES(a, b -> z)**/  --~ PROVED
/**ASSERT DETERMINES(a -> z)**/  --~ UNKNOWN

-- case: F4
SELECT t.id, u.k FROM t FULL JOIN u ON u.k = t.a
/**ASSERT UNIQUE(id)**/  --~ PROVED
/**ASSERT NOT NULL UNIQUE(id)**/  --~ UNKNOWN

-- case: F2_constant_minus
-- Right-only rows keep any z: ON holds on matched rows only.
SELECT t.id, u.z FROM t FULL JOIN u ON u.z = 5
/**ASSERT ENUM(z IN (5))**/  --~ UNKNOWN

-- case: F2_same_side_minus
-- Right-only rows keep any w and q.
SELECT v.w, v.q FROM t FULL JOIN v ON v.w = v.q
/**ASSERT DETERMINES(w -> q)**/  --~ UNKNOWN

-- case: OR_branches
SELECT d, a, b, c FROM t WHERE (a = 5 AND b = c AND d = 1) OR (a = 5 AND c = b AND d = 2)
/**ASSERT DETERMINES(d -> a)**/  --~ PROVED
/**ASSERT DETERMINES(b -> c)**/  --~ PROVED

-- case: OR_branches_different_constants
SELECT b, a FROM t WHERE (a = 5 AND d = 1) OR (a = 6 AND d = 2)
/**ASSERT DETERMINES(b -> a)**/  --~ UNKNOWN
