FROM orders AS o
/**ASSERT EXACTLY ONE**/ LEFT JOIN users AS u  --~ PROVED
    ON u.id = o.user_id
/**ASSERT FOREIGN KEY(user_id) REFERENCES users(id)**/  --~ PROVED

-- case: coverage_onto_an_exactly_one_join_carries_over_from_its_left_input
CREATE TABLE refunds (order_id INTEGER NOT NULL REFERENCES orders(id));
WITH enriched AS (
    SELECT o.id, u.name
    FROM orders AS o
    /**ASSERT EXACTLY ONE**/ JOIN users AS u  --~ PROVED
        ON u.id = o.user_id
)
SELECT *
FROM refunds
/**ASSERT EXACTLY ONE**/ JOIN enriched  --~ PROVED
    ON refunds.order_id = enriched.id

-- case: coverage_onto_an_unproved_inner_join_does_not_carry_over
CREATE TABLE refunds (order_id INTEGER NOT NULL REFERENCES orders(id));
WITH enriched AS (
    SELECT o.id, u.name
    FROM orders AS o
    /**ASSERT EXACTLY ONE**/ JOIN users AS u  --~ UNKNOWN
        ON u.id = o.buyer
)
SELECT *
FROM refunds
/**ASSERT EXACTLY ONE**/ JOIN enriched  --~ UNKNOWN
    ON refunds.order_id = enriched.id

-- case: a_nullable_left_column_is_reported_as_the_only_missing_evidence
SELECT * FROM orders /**ASSERT EXACTLY ONE**/ JOIN users ON orders.buyer = users.id
--~ UNKNOWN "PROVED: At most one match" "PROVED: At least one match" "UNKNOWN: Non-null left column"

-- case: a_missing_foreign_key_is_reported_as_missing_guaranteed_matching
SELECT * FROM orders /**ASSERT EXACTLY ONE**/ JOIN users ON orders.plain = users.id
--~ UNKNOWN "PROVED: At most one match" "UNKNOWN: At least one match" "PROVED: Non-null left column"

-- case: every_missing_half_is_reported_separately
SELECT *
FROM events
/**ASSERT EXACTLY ONE**/ JOIN sessions
--~ UNKNOWN "UNKNOWN: At most one match" "UNKNOWN: At least one match" "UNKNOWN: Non-null left column"
    ON events.user_id = sessions.user_id

-- case: an_additional_predicate_is_named_in_the_explanation
SELECT *
FROM orders
/**ASSERT EXACTLY ONE**/ JOIN users
--~ UNKNOWN "column-to-column equalities"
    ON orders.user_id = users.id AND users.name = 'x'

-- case: referential_coverage_onto_a_non_unique_column_still_needs_a_unique_right_column
CREATE TABLE visits (user_id INTEGER NOT NULL REFERENCES sessions(user_id));
SELECT *
FROM visits
/**ASSERT EXACTLY ONE**/ JOIN sessions
--~ UNKNOWN "UNKNOWN: At most one match" "PROVED: At least one match" "PROVED: Non-null left column"
    ON visits.user_id = sessions.user_id

-- case: an_exactly_one_marker_in_an_unreferenced_cte_is_a_diagnostic
WITH enriched AS (SELECT orders.id FROM orders /**ASSERT EXACTLY ONE**/ JOIN users ON orders.user_id = users.id)
--~ unanalyzed-assertion "exactly one join assertion"
SELECT *
FROM orders

-- case: an_exactly_one_marker_not_before_a_join_is_unattached
SELECT * FROM orders /**ASSERT EXACTLY ONE**/ WHERE id = 1
--~ unattached-marker "exactly one join marker"

-- case: a_mistyped_exactly_one_marker_is_reported_with_the_marker_list
SELECT * FROM orders /**ASSERT EXACTLY 1**/ JOIN users ON orders.user_id = users.id
--~ unrecognized-marker "/**ASSERT EXACTLY ONE**/"

-- case: every_missing_half_of_a_composite_join_is_named
CREATE TABLE regions (country VARCHAR, code VARCHAR, label VARCHAR, PRIMARY KEY (country, code));
CREATE TABLE shops (
    id INTEGER PRIMARY KEY,
    country VARCHAR NOT NULL,
    code VARCHAR NOT NULL,
    other VARCHAR NOT NULL,
    maybe VARCHAR,
    FOREIGN KEY (country, code) REFERENCES regions(country, code),
    FOREIGN KEY (country, maybe) REFERENCES regions(country, code)
);
CREATE TABLE loose (country VARCHAR NOT NULL, code VARCHAR NOT NULL);
SELECT *
FROM loose AS l
/**ASSERT EXACTLY ONE**/ JOIN shops AS s
--~ UNKNOWN "UNKNOWN: At most one match" "UNKNOWN: At least one match" "No known Foreign Key from loose('country', 'code')" "PROVED: Non-null left columns"
    ON l.country = s.country AND l.code = s.maybe

-- case: each_nullable_left_column_is_named
CREATE TABLE regions (country VARCHAR, code VARCHAR, label VARCHAR, PRIMARY KEY (country, code));
CREATE TABLE shops (
    id INTEGER PRIMARY KEY,
    country VARCHAR NOT NULL,
    code VARCHAR NOT NULL,
    other VARCHAR NOT NULL,
    maybe VARCHAR,
    FOREIGN KEY (country, code) REFERENCES regions(country, code),
    FOREIGN KEY (country, maybe) REFERENCES regions(country, code)
);
CREATE TABLE loose (country VARCHAR NOT NULL, code VARCHAR NOT NULL);
SELECT *
FROM shops AS s
/**ASSERT EXACTLY ONE**/ JOIN regions AS r
--~ UNKNOWN "PROVED: At most one match" "PROVED: At least one match" "UNKNOWN: Non-null left columns" "'maybe' may be NULL"
    ON s.country = r.country AND s.maybe = r.code

-- case: a_narrowed_right_relation_is_named_in_the_explanation
CREATE TABLE regions (country VARCHAR, code VARCHAR, label VARCHAR, PRIMARY KEY (country, code));
CREATE TABLE shops (
    id INTEGER PRIMARY KEY,
    country VARCHAR NOT NULL,
    code VARCHAR NOT NULL,
    other VARCHAR NOT NULL,
    maybe VARCHAR,
    FOREIGN KEY (country, code) REFERENCES regions(country, code),
    FOREIGN KEY (country, maybe) REFERENCES regions(country, code)
);
CREATE TABLE loose (country VARCHAR NOT NULL, code VARCHAR NOT NULL);
WITH r AS (SELECT * FROM regions WHERE label = 'x')
SELECT *
FROM shops AS s
/**ASSERT EXACTLY ONE**/ JOIN r
--~ UNKNOWN "PROVED: At most one match" "UNKNOWN: At least one match" "may drop rows of its input"
    ON s.country = r.country AND s.code = r.code

-- case: an_extra_on_conjunct_leaves_only_matching_unknown
SELECT *
FROM orders
/**ASSERT EXACTLY ONE**/ JOIN users
--~ UNKNOWN "PROVED: At most one match" "UNKNOWN: At least one match" "PROVED: Non-null left columns"
    ON orders.user_id = users.id AND users.name = 'x'
