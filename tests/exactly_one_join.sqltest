SELECT *
FROM shops AS s
/**ASSERT EXACTLY ONE**/ JOIN r  --~ UNKNOWN
    ON s.country = r.country AND s.code = r.code

-- case: an_unproved_composite_or_derived_exactly_one_join_is_unknown__right_relation_narrowed_by_a_join
CREATE TABLE regions (country VARCHAR, code VARCHAR, label VARCHAR, PRIMARY KEY (country, code));
CREATE TABLE shops (
    id INTEGER PRIMARY KEY,
    country VARCHAR NOT NULL,
    code VARCHAR NOT NULL,
    other VARCHAR NOT NULL,
    maybe VARCHAR,
    FOREIGN KEY (country, code) REFERENCES regions(country, code),
    FOREIGN KEY (country, maybe) REFERENCES regions(country, code)
);
CREATE TABLE loose (country VARCHAR NOT NULL, code VARCHAR NOT NULL);
WITH r AS (SELECT regions.* FROM regions JOIN loose ON regions.code = loose.code)
SELECT *
FROM shops AS s
/**ASSERT EXACTLY ONE**/ JOIN r  --~ UNKNOWN
    ON s.country = r.country AND s.code = r.code

-- case: an_unproved_composite_or_derived_exactly_one_join_is_unknown__right_relation_duplicated_by_a_join
CREATE TABLE regions (country VARCHAR, code VARCHAR, label VARCHAR, PRIMARY KEY (country, code));
CREATE TABLE shops (
    id INTEGER PRIMARY KEY,
    country VARCHAR NOT NULL,
    code VARCHAR NOT NULL,
    other VARCHAR NOT NULL,
    maybe VARCHAR,
    FOREIGN KEY (country, code) REFERENCES regions(country, code),
    FOREIGN KEY (country, maybe) REFERENCES regions(country, code)
);
CREATE TABLE loose (country VARCHAR NOT NULL, code VARCHAR NOT NULL);
WITH r AS (SELECT regions.* FROM regions LEFT JOIN loose ON regions.code = loose.code)
SELECT *
FROM shops AS s
/**ASSERT EXACTLY ONE**/ JOIN r  --~ UNKNOWN
    ON s.country = r.country AND s.code = r.code

-- case: an_unproved_composite_or_derived_exactly_one_join_is_unknown__computed_left_column
CREATE TABLE regions (country VARCHAR, code VARCHAR, label VARCHAR, PRIMARY KEY (country, code));
CREATE TABLE shops (
    id INTEGER PRIMARY KEY,
    country VARCHAR NOT NULL,
    code VARCHAR NOT NULL,
    other VARCHAR NOT NULL,
    maybe VARCHAR,
    FOREIGN KEY (country, code) REFERENCES regions(country, code),
    FOREIGN KEY (country, maybe) REFERENCES regions(country, code)
);
CREATE TABLE loose (country VARCHAR NOT NULL, code VARCHAR NOT NULL);
SELECT *
FROM (SELECT upper(country) AS country, code FROM shops) AS s
/**ASSERT EXACTLY ONE**/ JOIN regions AS r  --~ UNKNOWN
    ON s.country = r.country AND s.code = r.code

