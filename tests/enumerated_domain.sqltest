SELECT status FROM orders /**ASSERT ENUM(status IN ('new'))**/
--~ UNKNOWN "No finite domain is known for status"

-- case: a_declaration_produces_no_assertion_and_is_shown_as_declared
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
/**ASSERT ENUM(status IN ('new', 'paid'))**/
--~ PROVED "Declared EnumeratedDomain"
