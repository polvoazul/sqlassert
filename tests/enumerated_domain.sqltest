--~ UNKNOWN

-- case: enum_is_not_guessed__left_join_on_literal_preserved_side
SELECT o.status
FROM orders o
LEFT JOIN codes c
    ON o.status = 'new'
/**ASSERT ENUM(status IN ('new'))**/  --~ UNKNOWN

-- case: enum_is_not_guessed__outer_join_on_never_crosses
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT c.code
FROM codes c
LEFT JOIN o
    ON c.code = o.status
/**ASSERT ENUM(code IN ('new', 'paid'))**/  --~ UNKNOWN

