-- Enumerated Domains: `ASSERT ENUM(col IN ('a', 'b'))` and its `DECLARE` form.
--
-- An Enumerated Domain bounds a column's non-null values to a finite set. It
-- comes from literals, declarations, external Knowledge, and filters, and
-- crosses value equalities. NULL is never in a domain: `NOT NULL` governs it.

CREATE TABLE orders (id INTEGER PRIMARY KEY, status VARCHAR, channel VARCHAR, kind VARCHAR);
CREATE TABLE codes (code VARCHAR, label VARCHAR);
CREATE TABLE items (id INTEGER PRIMARY KEY, qty INTEGER, size INTEGER, ratio FLOAT, flag BOOLEAN, tag VARCHAR);
CREATE TABLE people (name VARCHAR COLLATE NOCASE);

-- case: typed_enum_is_proved__numeric_literal
SELECT 1 AS n FROM orders /**ASSERT ENUM(n IN (1, 2))**/  --~ PROVED

-- case: typed_enum_is_proved__negative_numeric_literal
SELECT -1 AS n FROM orders /**ASSERT ENUM(n IN (-1, 0))**/  --~ PROVED

-- case: typed_enum_is_proved__decimal_literal
SELECT 2.5 AS n FROM orders /**ASSERT ENUM(n IN (2.5))**/  --~ PROVED

-- case: typed_enum_is_proved__boolean_literal
SELECT TRUE AS f FROM orders /**ASSERT ENUM(f IN (TRUE, FALSE))**/  --~ PROVED

-- case: typed_enum_is_proved__integer_spellings_are_one_value
SELECT 007 AS n FROM orders /**ASSERT ENUM(n IN (7))**/  --~ PROVED

-- case: typed_enum_is_proved__coalesce_of_typed_literals
SELECT coalesce(NULL, 3, 4) AS n FROM orders /**ASSERT ENUM(n IN (3, 4))**/  --~ PROVED

-- case: typed_enum_is_proved__where_numeric_equality
SELECT qty FROM items WHERE qty = 3 /**ASSERT ENUM(qty IN (3))**/  --~ PROVED

-- case: typed_enum_is_proved__where_numeric_in_list
SELECT qty FROM items WHERE qty IN (1, 2) /**ASSERT ENUM(qty IN (1, 2, 3))**/
--~ PROVED

-- case: typed_enum_is_proved__where_boolean_equality
SELECT flag FROM items WHERE flag = FALSE /**ASSERT ENUM(flag IN (FALSE))**/  --~ PROVED

-- case: typed_enum_is_proved__declared_numeric
WITH i AS (SELECT * FROM items /**DECLARE ENUM(qty IN (1, 2, 3))**/
/**DECLARE ENUM(flag IN (TRUE))**/) SELECT qty FROM i
/**ASSERT ENUM(qty IN (3, 2, 1))**/  --~ PROVED

-- case: typed_enum_is_proved__declared_boolean
WITH i AS (SELECT * FROM items /**DECLARE ENUM(qty IN (1, 2, 3))**/
/**DECLARE ENUM(flag IN (TRUE))**/) SELECT flag FROM i
/**ASSERT ENUM(flag IN (TRUE))**/  --~ PROVED

-- case: typed_enum_is_proved__declared_and_narrowed
WITH i AS (SELECT * FROM items /**DECLARE ENUM(qty IN (1, 2, 3))**/
/**DECLARE ENUM(flag IN (TRUE))**/) SELECT qty FROM i WHERE qty IN (2, 5)
/**ASSERT ENUM(qty IN (2))**/  --~ PROVED

-- case: typed_enum_is_proved__across_a_numeric_equality
WITH i AS (SELECT * FROM items /**DECLARE ENUM(qty IN (1, 2, 3))**/
/**DECLARE ENUM(flag IN (TRUE))**/) SELECT size FROM i WHERE size = qty
/**ASSERT ENUM(size IN (1, 2, 3))**/  --~ PROVED

-- case: typed_enum_is_proved__view
CREATE VIEW v AS SELECT qty FROM items /**DECLARE ENUM(qty IN (1, 2))**/;
SELECT qty FROM v /**ASSERT ENUM(qty IN (1, 2))**/  --~ PROVED

-- case: typed_enum_is_proved__mixed_types
WITH m AS (SELECT * FROM items /**DECLARE ENUM(tag IN ('a', 1, TRUE))**/)
SELECT tag
FROM m
/**ASSERT ENUM(tag IN (TRUE, 1, 'a'))**/  --~ PROVED

-- case: typed_enum_is_proved__p16
WITH a AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('01'))**/
/**DECLARE ENUM(channel IN ('1'))**/), j AS (SELECT a.status, a.channel
FROM a
JOIN items
    ON a.status = items.qty AND items.qty = a.channel) SELECT status FROM j WHERE status = channel
/**ASSERT ENUM(status IN ('zz'))**/  --~ PROVED

-- case: typed_enum_is_not_guessed__numeric_one_is_not_string_one
SELECT 1 AS n FROM orders /**ASSERT ENUM(n IN ('1'))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__string_one_is_not_numeric_one
SELECT '1' AS n FROM orders /**ASSERT ENUM(n IN (1))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__boolean_true_is_not_numeric_one
SELECT TRUE AS f FROM orders /**ASSERT ENUM(f IN (1))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__decimal_scale_is_part_of_the_literal
SELECT 1.0 AS n FROM orders /**ASSERT ENUM(n IN (1))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__exponent_literal_is_not_the_integer
SELECT 1e0 AS n FROM orders /**ASSERT ENUM(n IN (1))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__declared_subset_asserted
WITH i AS (SELECT * FROM items /**DECLARE ENUM(qty IN (1, 2, 3))**/
/**DECLARE ENUM(flag IN (TRUE))**/) SELECT qty FROM i
/**ASSERT ENUM(qty IN (1, 2))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__table_column
SELECT qty FROM items /**ASSERT ENUM(qty IN (1))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__float_rounding
WITH r AS (SELECT * FROM items /**DECLARE ENUM(ratio IN (0.1))**/)
SELECT ratio
FROM r
WHERE ratio = 0.100000001
/**ASSERT ENUM(ratio IN (5))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__text_cast_to_a_numeric_literal_s_scale
WITH t AS (SELECT * FROM items /**DECLARE ENUM(tag IN (1))**/)
SELECT tag
FROM t
WHERE tag = 1.4
/**ASSERT ENUM(tag IN (5))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__a_string_and_a_number_may_meet
WITH t AS (SELECT * FROM items /**DECLARE ENUM(qty IN ('1'))**/)
SELECT qty
FROM t
WHERE qty = 1
/**ASSERT ENUM(qty IN (5))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__two_strings_may_equal_one_integer
WITH t AS (SELECT * FROM items /**DECLARE ENUM(qty IN ('01'))**/)
SELECT qty
FROM t
WHERE qty = '1'
/**ASSERT ENUM(qty IN ('2'))**/  --~ UNKNOWN

-- case: typed_enum_is_not_guessed__two_strings_may_equal_under_a_collation
WITH p AS (SELECT * FROM people /**DECLARE ENUM(name IN ('a'))**/)
SELECT name
FROM p
WHERE name = 'A'
/**ASSERT ENUM(name IN ('b'))**/  --~ UNKNOWN

-- case: a_cast_based_equality_does_not_transfer_a_domain
WITH t AS (SELECT qty, tag FROM items /**DECLARE ENUM(qty IN ('01'))**/)
SELECT tag
FROM t
WHERE qty = tag
/**ASSERT ENUM(tag IN ('01'))**/  --~ UNKNOWN

-- case: distinct_numeric_literals_do_not_meet
WITH i AS (SELECT * FROM items /**DECLARE ENUM(qty IN (1, 2, 3))**/
/**DECLARE ENUM(flag IN (TRUE))**/) SELECT qty FROM i WHERE qty IN (3, 4)
/**ASSERT ENUM(qty IN (3))**/  --~ PROVED

-- case: enum_is_proved__string_literal
SELECT 'a' AS tag FROM orders /**ASSERT ENUM(tag IN ('a', 'b'))**/  --~ PROVED

-- case: enum_is_proved__null_literal_is_outside_every_domain
SELECT NULL AS tag FROM orders /**ASSERT ENUM(tag IN ('a'))**/  --~ PROVED

-- case: enum_is_proved__coalesce_of_literals
SELECT coalesce(NULL, 'b') AS tag FROM orders /**ASSERT ENUM(tag IN ('a', 'b'))**/
--~ PROVED

-- case: enum_is_proved__declared_same_set
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__declared_superset_asserted
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
/**ASSERT ENUM(status IN ('paid', 'new', 'void'))**/  --~ PROVED

-- case: enum_is_proved__renamed
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status AS state
FROM o
/**ASSERT ENUM(state IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__filtered
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
WHERE id > 3
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__alias
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT x.status
FROM o AS x
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__nested_cte
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/) , p AS (SELECT status FROM o)
SELECT status
FROM p
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__subquery
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM (SELECT status FROM o) AS s
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__grouping_key
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status, count(*) AS n
FROM o
GROUP BY status
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__distinct
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT DISTINCT status
FROM o
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__left_join_padded_side
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT o.status
FROM codes c
LEFT JOIN o
    ON c.code = o.channel
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__where_equality_to_a_literal
SELECT status FROM orders WHERE status = 'paid' /**ASSERT ENUM(status IN ('paid'))**/
--~ PROVED

-- case: enum_is_proved__literal_on_the_left
SELECT status FROM orders WHERE 'paid' = status /**ASSERT ENUM(status IN ('paid'))**/
--~ PROVED

-- case: enum_is_proved__where_in_list
SELECT status
FROM orders
WHERE status IN ('new', 'paid')
/**ASSERT ENUM(status IN ('new', 'paid', 'void'))**/  --~ PROVED

-- case: enum_is_proved__inner_join_on_literal
SELECT o.status
FROM codes c
JOIN orders o
    ON o.status = 'new'
/**ASSERT ENUM(status IN ('new'))**/  --~ PROVED

-- case: enum_is_proved__left_join_on_literal_padded_side
SELECT o.status
FROM codes c
LEFT JOIN orders o
    ON o.status = 'new'
/**ASSERT ENUM(status IN ('new'))**/  --~ PROVED

-- case: enum_is_proved__declared_and_narrowed
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
WHERE status IN ('paid', 'void')
/**ASSERT ENUM(status IN ('paid'))**/  --~ PROVED

-- case: enum_is_proved__across_a_where_equality
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT orders.channel
FROM o
JOIN orders
    ON TRUE
WHERE orders.channel = o.status
/**ASSERT ENUM(channel IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__across_an_inner_join
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT c.code
FROM o
JOIN codes c
    ON c.code = o.status
/**ASSERT ENUM(code IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__across_an_equality_to_a_narrowed_column
SELECT channel
FROM orders
WHERE channel = status AND status = 'x'
/**ASSERT ENUM(channel IN ('x'))**/  --~ PROVED

-- case: enum_is_proved__view
CREATE VIEW v AS SELECT status FROM orders /**DECLARE ENUM(status IN ('new'))**/;
SELECT status FROM v /**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

-- case: enum_is_proved__intersecting_declarations_across_an_equality
WITH a AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('x', 'y'))**/
/**DECLARE ENUM(channel IN ('y', 'z'))**/) SELECT status FROM a WHERE status = channel
/**ASSERT ENUM(status IN ('y'))**/  --~ PROVED

-- case: enum_is_proved__intersect_keeps_the_left_domain
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/) , i AS (SELECT status FROM o INTERSECT SELECT status FROM orders)
SELECT status
FROM i
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED

