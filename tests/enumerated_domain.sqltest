-- case: enum_is_not_guessed__declared_subset_asserted
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
/**ASSERT ENUM(status IN ('new'))**/  --~ UNKNOWN

-- case: enum_is_not_guessed__opaque_expression
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
