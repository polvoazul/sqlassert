SELECT status, channel FROM orders /**ASSERT ENUM(status IN (1, 2, 1))**/
--~ unattached-marker "lists 1 more than once"

-- case: a_malformed_enum_marker_is_diagnosed__p5
SELECT status, channel FROM orders /**ASSERT ENUM(status IN (7, 007))**/
--~ unattached-marker "lists 7 more than once"

-- case: a_malformed_enum_marker_is_diagnosed__p6
SELECT status, channel FROM orders /**ASSERT ENUM(status IN (TRUE, true))**/
--~ unattached-marker "lists TRUE more than once"

-- case: a_malformed_enum_marker_is_diagnosed__p7
SELECT status, channel FROM orders /**ASSERT ENUM(status IN (DATE '2020-01-01'))**/
--~ unattached-marker "lists CAST('2020-01-01' AS DATE), which is not a string, numeric, or boolean literal"

-- case: a_malformed_enum_marker_is_diagnosed__assert_enum_status_in_1_1_lists_1_1_which_is_not
SELECT status, channel FROM orders /**ASSERT ENUM(status IN (1 + 1))**/
--~ unattached-marker "lists 1 + 1, which is not"

-- case: a_malformed_enum_marker_is_diagnosed__p9
SELECT status, channel FROM orders /**ASSERT ENUM(status IN (channel))**/
--~ unattached-marker "lists channel, which is not"

-- case: a_malformed_enum_marker_is_diagnosed__assert_enum_status_in_a_which_is_not
SELECT status, channel FROM orders /**ASSERT ENUM(status IN (-'a'))**/
--~ unattached-marker "which is not"

-- case: a_malformed_enum_marker_is_diagnosed__assert_enum_status_a_must_be_written
SELECT status, channel FROM orders /**ASSERT ENUM(status ('a'))**/
--~ unattached-marker "must be written"

-- case: a_malformed_enum_marker_is_diagnosed__assert_enum_status_channel_in_a_must_be_written
SELECT status, channel FROM orders /**ASSERT ENUM(status, channel IN ('a'))**/
--~ unattached-marker "must be written"

-- case: values_of_different_types_spelled_alike_are_not_duplicates
SELECT status FROM orders /**ASSERT ENUM(status IN (1, '1', TRUE, 'TRUE', 1.0))**/
--~ UNKNOWN

-- case: a_domain_flows_through_set_operations__union_without_from
WITH u AS (SELECT 'a' AS tag UNION ALL SELECT 'b')
SELECT tag
FROM u
/**ASSERT ENUM(tag IN ('a', 'b'))**/  --~ PROVED

-- case: a_domain_flows_through_set_operations__union_of_literals
WITH u AS (SELECT 'new' AS s FROM orders UNION SELECT 'paid' FROM orders)
SELECT s
FROM u
/**ASSERT ENUM(s IN ('new', 'paid'))**/  --~ PROVED

-- case: a_domain_flows_through_set_operations__union_with_a_declared_source
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/) , u AS (SELECT status FROM o UNION ALL SELECT 'void' FROM orders)
SELECT status
FROM u
/**ASSERT ENUM(status IN ('new', 'paid', 'void'))**/  --~ PROVED

-- case: a_domain_flows_through_set_operations__union_missing_a_value
WITH u AS (SELECT 'new' AS s FROM orders UNION SELECT 'paid' FROM orders)
SELECT s
FROM u
/**ASSERT ENUM(s IN ('new'))**/  --~ UNKNOWN

-- case: a_domain_flows_through_set_operations__union_with_an_unbounded_input
WITH u AS (SELECT 'new' AS s FROM orders UNION ALL SELECT status FROM orders)
SELECT s
FROM u
/**ASSERT ENUM(s IN ('new'))**/  --~ UNKNOWN

-- case: a_domain_flows_through_set_operations__union_of_mixed_types
WITH u AS (SELECT 1 AS s FROM orders UNION SELECT 'a' FROM orders)
SELECT s
FROM u
/**ASSERT ENUM(s IN (1, 'a'))**/  --~ UNKNOWN

-- case: a_domain_flows_through_set_operations__union_by_name
WITH u AS (SELECT 'new' AS s FROM orders UNION BY NAME SELECT 'paid' AS s FROM orders)
SELECT s
FROM u
/**ASSERT ENUM(s IN ('new', 'paid'))**/  --~ UNKNOWN

-- case: a_domain_flows_through_set_operations__intersect_bounded_by_the_right
WITH u AS (SELECT status FROM orders INTERSECT SELECT 'paid' FROM orders)
SELECT status
FROM u
/**ASSERT ENUM(status IN ('paid'))**/  --~ PROVED

-- case: a_domain_flows_through_set_operations__intersect_under_nocase
WITH u AS (SELECT name FROM people INTERSECT SELECT 'ann' FROM people)
SELECT name
FROM u
/**ASSERT ENUM(name IN ('ann'))**/  --~ UNKNOWN

-- case: a_domain_flows_through_set_operations__intersect_of_numbers
WITH u AS (SELECT qty FROM items INTERSECT SELECT 2 FROM items)
SELECT qty
FROM u
/**ASSERT ENUM(qty IN (2))**/  --~ PROVED

-- case: a_domain_flows_through_set_operations__except_bounded_by_the_left
WITH u AS (SELECT 'new' AS s FROM orders EXCEPT SELECT status FROM orders)
SELECT s
FROM u
/**ASSERT ENUM(s IN ('new'))**/  --~ PROVED

-- case: a_domain_flows_through_set_operations__except_not_bounded_by_the_right
WITH u AS (SELECT status FROM orders EXCEPT SELECT 'new' FROM orders)
SELECT status
FROM u
/**ASSERT ENUM(status IN ('new'))**/  --~ UNKNOWN

-- case: an_or_bounds_a_column_every_branch_bounds__status_a_or_status_b_a_b_outcome_proved
SELECT status
FROM orders
WHERE status = 'a' OR status = 'b'
/**ASSERT ENUM(status IN ('a', 'b'))**/  --~ PROVED

