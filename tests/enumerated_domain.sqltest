--~ UNKNOWN

-- case: enum_is_not_guessed__aggregate
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT max(status) AS m
FROM o
/**ASSERT ENUM(m IN ('new', 'paid'))**/  --~ UNKNOWN

-- case: a_declaration_does_not_claim_its_values_occur_or_that_the_column_is_non_null
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/)
SELECT status
FROM o
/**ASSERT NOT NULL(status)**/  --~ UNKNOWN

-- case: not_null_and_enum_together_bound_every_value
WITH o AS (SELECT * FROM orders /**DECLARE ENUM(status IN ('new', 'paid'))**/) , p AS (SELECT status FROM o
/**DECLARE NOT NULL(status)**/) SELECT status FROM p
/**ASSERT ENUM(status IN ('new', 'paid'))**/  --~ PROVED
/**ASSERT NOT NULL(status)**/  --~ PROVED

-- case: an_enum_marker_on_a_missing_column_is_diagnosed
SELECT status FROM orders /**ASSERT ENUM(nope IN ('a'))**/
--~ unknown-asserted-column

