-- Issue 45: HAVING, VALUES in FROM, and correlated aggregate subqueries.

CREATE TABLE emp (empno INTEGER PRIMARY KEY, deptno INTEGER, sal INTEGER, job VARCHAR);
CREATE TABLE dept (deptno INTEGER PRIMARY KEY);

-- HAVING removes groups: the grouping key survives, and a condition on a
-- selected item narrows that item's column.
-- case: having_keeps_the_key_and_narrows_selected_items
SELECT deptno, count(*) AS c, max(sal) AS m FROM emp GROUP BY deptno
HAVING count(*) > 1 AND max(sal) IS NOT NULL AND deptno IN (10, 20)
/**ASSERT UNIQUE(deptno)**/  --~ PROVED
/**ASSERT NOT NULL(m)**/  --~ PROVED
/**ASSERT ENUM(deptno IN (10, 20))**/  --~ PROVED

-- The grouped key stays a key under HAVING, so a join on it is many to one.
-- case: having_keeps_the_key_for_a_join
WITH per_dept AS (SELECT deptno, count(*) AS n FROM emp GROUP BY deptno HAVING count(*) > 1)
SELECT * FROM dept
/**ASSERT MANY TO ONE**/ JOIN per_dept ON dept.deptno = per_dept.deptno  --~ PROVED

-- A condition on an aggregate not selected states nothing of its own.
-- case: having_on_an_unselected_aggregate_keeps_the_key_only
SELECT deptno, count(*) AS c FROM emp GROUP BY deptno HAVING sum(sal) > 10
/**ASSERT UNIQUE(deptno)**/  --~ PROVED
/**ASSERT NOT NULL(deptno)**/  --~ UNKNOWN

-- case: values_states_its_literals
SELECT * FROM (VALUES (1, 'X'), (2, 'Y'), (3, NULL)) AS t (a, b)
/**ASSERT NOT NULL UNIQUE(a)**/  --~ PROVED
/**ASSERT UNIQUE(b)**/  --~ PROVED
/**ASSERT NOT NULL(b)**/  --~ UNKNOWN
/**ASSERT ENUM(a IN (1, 2, 3))**/  --~ PROVED

-- 1 and 1.0 are equal; NULLs never repeat in a (lax) Unique Set.
-- case: values_uniqueness_compares_by_value
SELECT * FROM (VALUES (1, NULL), (1.0, NULL)) AS t (a, b)
/**ASSERT UNIQUE(a)**/  --~ UNKNOWN
/**ASSERT UNIQUE(b)**/  --~ PROVED

-- An expression among the values states nothing for its column.
-- case: values_with_an_expression
SELECT * FROM (VALUES (1 + 1), (3)) AS t (a)
/**ASSERT NOT NULL(a)**/  --~ UNKNOWN

-- count over no matching rows is 0, not NULL (the count bug).
-- case: a_correlated_count_is_never_null
SELECT deptno, (SELECT count(*) FROM emp WHERE emp.deptno = dept.deptno) AS n FROM dept
/**ASSERT NOT NULL UNIQUE(deptno)**/  --~ PROVED
/**ASSERT NOT NULL(n)**/  --~ PROVED

-- case: a_correlated_max_is_null_without_a_match
SELECT deptno, (SELECT max(sal) FROM emp WHERE emp.deptno = dept.deptno) AS m FROM dept
/**ASSERT NOT NULL(m)**/  --~ UNKNOWN

-- One value per deptno: equal to a key it pins one row per deptno; equal to
-- sal it does not (two may tie).
-- case: a_correlated_aggregate_is_a_function_of_its_key__key
SELECT empno, deptno FROM emp AS a WHERE empno = (SELECT max(empno) FROM emp AS b WHERE b.deptno = a.deptno AND b.sal > 0)
/**ASSERT UNIQUE(deptno)**/  --~ PROVED

-- case: a_correlated_aggregate_is_a_function_of_its_key__not_a_key
SELECT empno, deptno FROM emp AS a WHERE sal = (SELECT max(sal) FROM emp AS b WHERE b.deptno = a.deptno)
/**ASSERT UNIQUE(deptno)**/  --~ UNKNOWN

-- count_if over no rows is 0, not NULL: not decorrelated, so nothing is known.
-- case: a_correlated_count_if_is_not_decorrelated
SELECT deptno, (SELECT count_if(sal > 0) FROM emp WHERE emp.deptno = dept.deptno) AS n FROM dept
/**ASSERT NOT NULL UNIQUE(deptno)**/  --~ PROVED
/**ASSERT NOT NULL(n)**/  --~ UNKNOWN

-- An aggregate of only outer columns belongs to the outer query.
-- case: an_aggregate_of_outer_columns_is_not_decorrelated
SELECT empno FROM emp AS a WHERE sal = (SELECT max(a.sal) FROM emp AS b WHERE b.deptno = a.deptno)
/**ASSERT UNIQUE(empno)**/  --~ PROVED

-- A grouping key not selected still splits the groups: the selected key
-- alone is not unique, but its columns keep what they knew.
-- case: an_unselected_grouping_key_is_a_hidden_output
SELECT deptno, count(*) AS c FROM emp GROUP BY deptno, job
/**ASSERT UNIQUE(deptno)**/  --~ UNKNOWN
/**ASSERT NOT NULL(c)**/  --~ PROVED

-- HAVING may read it: pinned to one value, the other key is a key alone.
-- case: having_reads_an_unselected_grouping_key
SELECT job, count(*) AS c FROM emp GROUP BY sal, job HAVING sal = 3
/**ASSERT UNIQUE(job)**/  --~ PROVED

-- A name that is both an alias and the column it selects is that column.
-- case: a_grouping_name_that_is_its_own_alias
SELECT emp.job AS job, count(*) AS c FROM emp GROUP BY job
/**ASSERT UNIQUE(job)**/  --~ PROVED

-- A name that may be a select alias of something else is not guessed at:
-- dialects disagree on which one GROUP BY reads.
-- case: a_grouping_name_that_may_be_an_alias_stays_opaque
SELECT upper(job) AS job, count(*) AS c FROM emp GROUP BY job
/**ASSERT NOT NULL(c)**/  --~ UNKNOWN
