-- Unique Sets derived from recognized `ROW_NUMBER() OVER (PARTITION BY ...) = 1`
-- QualifyByPartition qualification.
--
-- Only this narrow shape earns a Unique Set, by its complete Partition Key,
-- because that predicate keeps exactly one row per partition. Every case here
-- wraps the qualified query in a CTE, exercising #5's lowering together with
-- this recognition, exactly like `test_analyze_aggregate_and_distinct.py` does
-- for GROUP BY and DISTINCT.

-- case: a_qualify_by_partition_subquery_joined_on_its_full_composite_partition_key_is_proved
CREATE TABLE orders (customer_id INTEGER, region VARCHAR, order_id INTEGER, amount INTEGER);
CREATE TABLE customer_regions (customer_id INTEGER, region VARCHAR);

WITH latest_order AS (
    SELECT customer_id, region, order_id, amount
    FROM orders
    QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id, region ORDER BY order_id DESC) = 1
)
SELECT *
FROM customer_regions
/**ASSERT MANY TO ONE**/ JOIN latest_order  --~ PROVED
    ON customer_regions.customer_id = latest_order.customer_id
    AND customer_regions.region = latest_order.region

-- case: joining_on_part_of_a_composite_partition_key_is_unknown
CREATE TABLE orders (customer_id INTEGER, region VARCHAR, order_id INTEGER, amount INTEGER);
CREATE TABLE customer_regions (customer_id INTEGER, region VARCHAR);

WITH latest_order AS (
    SELECT customer_id, region, order_id, amount
    FROM orders
    QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id, region ORDER BY order_id DESC) = 1
)
SELECT *
FROM customer_regions
/**ASSERT MANY TO ONE**/ JOIN latest_order  --~ UNKNOWN
    ON customer_regions.customer_id = latest_order.customer_id

-- QUALIFY over GROUP BY keeps one row per partition of the groups.
-- case: qualify_over_groups_keeps_one_row_per_partition
CREATE TABLE emp (empno INTEGER PRIMARY KEY, deptno INTEGER, job VARCHAR);

SELECT deptno, job, count(*) AS n
FROM emp
GROUP BY deptno, job
HAVING count(*) > 1
QUALIFY row_number() OVER (PARTITION BY job ORDER BY count(*) DESC) = 1
/**ASSERT UNIQUE(job)**/  --~ PROVED

-- A partition key that is a bare name another item is aliased to may read
-- that alias: no Unique Set.
-- case: qualify_over_groups_by_a_name_an_alias_shadows_is_unknown
CREATE TABLE emp (empno INTEGER PRIMARY KEY, deptno INTEGER, job VARCHAR);

SELECT deptno AS dept, job AS deptno
FROM emp
GROUP BY 1, 2
QUALIFY row_number() OVER (PARTITION BY deptno) = 1
/**ASSERT UNIQUE(dept)**/  --~ UNKNOWN

-- Any other QUALIFY drops rows: the grouped or distinct rows keep their key,
-- but no longer every value, so a join onto them may miss.
-- case: other_qualify_over_groups_or_distinct_drops_rows
CREATE TABLE dept (deptno INTEGER PRIMARY KEY);
CREATE TABLE emp (empno INTEGER PRIMARY KEY, deptno INTEGER NOT NULL REFERENCES dept (deptno));

SELECT e.empno
FROM emp AS e
/**ASSERT EXACTLY ONE**/ JOIN (  --~ UNKNOWN
    SELECT deptno FROM dept GROUP BY deptno QUALIFY sum(1) OVER () > 5
) AS d
    ON e.deptno = d.deptno
/**ASSERT EXACTLY ONE**/ JOIN (  --~ UNKNOWN
    SELECT DISTINCT deptno FROM dept QUALIFY sum(1) OVER () > 5
) AS d2
    ON e.deptno = d2.deptno
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT DISTINCT deptno FROM dept QUALIFY sum(1) OVER () > 5
) AS d3
    ON e.deptno = d3.deptno

-- A QUALIFY (or DISTINCT ON) that is not one row per selected partition key
-- only drops rows of the projection: the select keeps its columns' lineage,
-- types and facts of each row (a key of the input, NOT NULL, an Enumerated
-- Domain), and loses every fact that needs all of them (a join onto it
-- covering each left row).

-- A partition key selected only through a cast is not an output.
-- case: a_partition_key_selected_through_a_cast_keeps_the_rows_facts
CREATE TABLE t (k INTEGER PRIMARY KEY, org VARCHAR NOT NULL, ts INTEGER);
CREATE TABLE f (k INTEGER NOT NULL REFERENCES t (k), g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT k, CAST(org AS TEXT) AS org
    FROM t
    QUALIFY ROW_NUMBER() OVER (PARTITION BY k, org ORDER BY ts DESC) = 1
    /**ASSERT NOT NULL UNIQUE(k)**/  --~ PROVED
    /**ASSERT NOT NULL(org)**/  --~ PROVED
    /**ASSERT UNIQUE(org)**/  --~ UNKNOWN
) AS s ON s.k = f.k
/**ASSERT EXACTLY ONE**/ JOIN (  --~ UNKNOWN
    SELECT k FROM t QUALIFY ROW_NUMBER() OVER (PARTITION BY k, org ORDER BY ts DESC) = 1
) AS s2 ON s2.k = f.k

-- A key of the input that is not the partition key stays unique only when it
-- is the selected key: the partition key says nothing of the other columns.
-- case: a_partition_key_that_is_not_selected_is_no_unique_set
CREATE TABLE t (k INTEGER, org VARCHAR, ts INTEGER);
SELECT k
FROM t
QUALIFY ROW_NUMBER() OVER (PARTITION BY k, org ORDER BY ts DESC) = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- Selected columns that determine each partition key are a Unique Set of the
-- select: at most one row per value of the key, and the key is a function of them.
-- case: selected_columns_that_determine_every_partition_key_are_unique
CREATE TABLE c (id INTEGER PRIMARY KEY, org VARCHAR NOT NULL);
CREATE TABLE u (k INTEGER NOT NULL, cid INTEGER NOT NULL REFERENCES c (id));
CREATE TABLE f (k INTEGER, cid INTEGER, g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT u.k, c.id
    FROM u JOIN c ON c.id = u.cid
    QUALIFY ROW_NUMBER() OVER (PARTITION BY u.k, c.org::varchar, c.id ORDER BY u.k) = 1
    /**ASSERT UNIQUE(k, id)**/  --~ PROVED
    /**ASSERT UNIQUE(id)**/  --~ UNKNOWN
) AS s ON s.k = f.k AND s.id = f.cid
/**ASSERT MANY TO ONE**/ JOIN (  --~ UNKNOWN
    SELECT u.k, c.id
    FROM u JOIN c ON c.id = u.cid
    QUALIFY ROW_NUMBER() OVER (PARTITION BY u.k, c.org::varchar, c.id ORDER BY u.k) = 1
) AS s2 ON s2.k = f.k

-- A key not selected, written through a column the selected ones determine.
-- case: a_partition_key_a_selected_column_determines_is_one_row_per_value
CREATE TABLE c (id INTEGER PRIMARY KEY, org VARCHAR NOT NULL);
CREATE TABLE u (k INTEGER NOT NULL, cid INTEGER NOT NULL);

SELECT u.k, c.id
FROM u JOIN c ON c.id = u.cid
QUALIFY ROW_NUMBER() OVER (PARTITION BY u.k, c.org ORDER BY u.k) = 1
/**ASSERT UNIQUE(k, id)**/  --~ PROVED

-- The selected columns determine only some keys.
-- case: selected_columns_that_leave_a_partition_key_free_are_not_unique
CREATE TABLE c (id INTEGER PRIMARY KEY, org VARCHAR NOT NULL);
CREATE TABLE u (k INTEGER NOT NULL, cid INTEGER NOT NULL);

SELECT u.k
FROM u JOIN c ON c.id = u.cid
QUALIFY ROW_NUMBER() OVER (PARTITION BY u.k, c.id ORDER BY u.k) = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- A bare name that may be a select alias is not read as the input's column.
-- case: a_partition_key_that_may_be_a_select_alias_is_not_the_input_column
CREATE TABLE t (k INTEGER, org INTEGER, v INTEGER, ts INTEGER);
SELECT k, v AS org
FROM t
QUALIFY ROW_NUMBER() OVER (PARTITION BY k, org ORDER BY ts) = 1
/**ASSERT UNIQUE(k, org)**/  --~ UNKNOWN

-- A key whose value varies between evaluations is no partition of the output.
-- case: a_nondeterministic_partition_key_is_no_unique_set
CREATE TABLE t (k INTEGER, ts INTEGER);
SELECT random() AS r, k
FROM t
QUALIFY ROW_NUMBER() OVER (PARTITION BY random() ORDER BY ts) = 1
/**ASSERT UNIQUE(r)**/  --~ UNKNOWN

-- A numeric literal key is no column; it names no partition of the output.
-- case: a_literal_partition_key_is_not_a_column
CREATE TABLE t (k INTEGER, v INTEGER);
SELECT v, k
FROM t
QUALIFY ROW_NUMBER() OVER (PARTITION BY 1 ORDER BY k) = 1
/**ASSERT UNIQUE(v)**/  --~ UNKNOWN

-- Any other QUALIFY drops rows: a row subset keeps its columns' facts.
-- case: a_qualify_that_is_not_one_row_per_partition_keeps_the_rows_facts
CREATE TABLE t (k INTEGER PRIMARY KEY, status VARCHAR NOT NULL CHECK (status IN ('a', 'b')), ts INTEGER);
CREATE TABLE f (k INTEGER NOT NULL REFERENCES t (k), g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT k, status FROM t QUALIFY RANK() OVER (ORDER BY ts) = 1
    /**ASSERT NOT NULL(status)**/  --~ PROVED
    /**ASSERT ENUM(status IN ('a', 'b'))**/  --~ PROVED
) AS ranked ON ranked.k = f.k
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT k FROM t QUALIFY ROW_NUMBER() OVER (PARTITION BY status ORDER BY ts) <= 2
) AS top_two ON top_two.k = f.k
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT k FROM t QUALIFY ts > min(ts) OVER ()
) AS late ON late.k = f.k
/**ASSERT EXACTLY ONE**/ JOIN (  --~ UNKNOWN
    SELECT k FROM t QUALIFY ts > min(ts) OVER ()
) AS late2 ON late2.k = f.k

-- case: a_qualify_that_is_not_one_row_per_partition_is_no_unique_set
CREATE TABLE t (k INTEGER, status VARCHAR, ts INTEGER);
SELECT k, status
FROM t
QUALIFY ROW_NUMBER() OVER (PARTITION BY status ORDER BY ts) <= 2
/**ASSERT UNIQUE(status)**/  --~ UNKNOWN

-- ROW_NUMBER() = 1 over the whole select keeps at most one row.
-- case: qualify_row_number_without_partition_by_keeps_at_most_one_row
CREATE TABLE t (k INTEGER, v INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT k, v FROM t QUALIFY ROW_NUMBER() OVER (ORDER BY v DESC) = 1
) AS s ON s.k = f.k

-- A named window may partition: it says nothing of the row count.
-- case: qualify_row_number_over_a_named_window_may_partition
CREATE TABLE t (k INTEGER, v INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ UNKNOWN
    SELECT k, v FROM t QUALIFY ROW_NUMBER() OVER w = 1 WINDOW w AS (PARTITION BY k ORDER BY v)
) AS s ON s.v = f.k

-- A window function beside the QUALIFY is evaluated over the rows before it,
-- and is no fact of the select.
-- case: a_window_function_in_the_select_list_is_not_modelled
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER NOT NULL);
SELECT k, sum(v) OVER () AS total
FROM t
QUALIFY RANK() OVER (ORDER BY v) = 1
/**ASSERT NOT NULL UNIQUE(k)**/  --~ PROVED
/**ASSERT NOT NULL(total)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- A select that aggregates without GROUP BY, or has a HAVING, is one group,
-- not a projection of rows.
-- case: qualify_beside_an_aggregate_is_opaque
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ UNKNOWN, unsupported-construct "QUALIFY beside an aggregate without GROUP BY"
    SELECT max(k) AS k FROM t QUALIFY RANK() OVER (ORDER BY max(k)) = 1
) AS s ON s.k = f.k

-- case: qualify_beside_having_is_opaque
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ UNKNOWN, unsupported-construct "QUALIFY with HAVING"
    SELECT k FROM t HAVING k > 1 QUALIFY RANK() OVER (ORDER BY k) = 1
) AS s ON s.k = f.k

-- DISTINCT ON a key that is not selected: one row per value of it.
-- case: distinct_on_a_key_the_selected_columns_determine_is_one_row_per_value
CREATE TABLE c (id INTEGER PRIMARY KEY, org VARCHAR NOT NULL);
CREATE TABLE u (k INTEGER NOT NULL, cid INTEGER NOT NULL);

SELECT DISTINCT ON (u.k, c.org) u.k, c.id
FROM u JOIN c ON c.id = u.cid
ORDER BY u.k, c.org
/**ASSERT UNIQUE(k, id)**/  --~ PROVED

-- case: distinct_on_a_key_not_selected_keeps_the_rows_facts
CREATE TABLE t (k INTEGER PRIMARY KEY, z INTEGER, v INTEGER NOT NULL);
CREATE TABLE f (k INTEGER NOT NULL REFERENCES t (k), g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ PROVED
    SELECT DISTINCT ON (z) k, v FROM t ORDER BY z, v
    /**ASSERT NOT NULL(v)**/  --~ PROVED
    /**ASSERT UNIQUE(v)**/  --~ UNKNOWN
) AS s ON s.k = f.k
/**ASSERT EXACTLY ONE**/ JOIN (  --~ UNKNOWN
    SELECT DISTINCT ON (z) k FROM t ORDER BY z, v
) AS s2 ON s2.k = f.k

-- A literal is an output position in DISTINCT ON, not a constant.
-- case: distinct_on_a_position_is_no_partition_key
CREATE TABLE t (k INTEGER, v INTEGER);
SELECT DISTINCT ON (1) k, v FROM t ORDER BY 1
/**ASSERT UNIQUE(v)**/  --~ UNKNOWN

-- A QUALIFY beside DISTINCT ON drops rows first; the one row per key stays.
-- case: distinct_on_with_qualify_keeps_one_row_per_key
CREATE TABLE t (k INTEGER, v INTEGER NOT NULL);
SELECT DISTINCT ON (k) k, v
FROM t
QUALIFY RANK() OVER (ORDER BY v) = 1
ORDER BY k
/**ASSERT UNIQUE(k)**/  --~ PROVED
/**ASSERT NOT NULL(v)**/  --~ PROVED
/**ASSERT UNIQUE(v)**/  --~ UNKNOWN

-- case: distinct_on_a_key_not_selected_beside_qualify_is_a_row_subset
CREATE TABLE t (k INTEGER PRIMARY KEY, z INTEGER, v INTEGER NOT NULL);
SELECT DISTINCT ON (z) k, v
FROM t
QUALIFY RANK() OVER (ORDER BY v) = 1
ORDER BY z
/**ASSERT NOT NULL UNIQUE(k)**/  --~ PROVED
/**ASSERT UNIQUE(v)**/  --~ UNKNOWN

-- DISTINCT ON with a HAVING but no GROUP BY is one group: opaque.
-- case: distinct_on_with_having_is_opaque
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN (  --~ UNKNOWN, unsupported-construct "DISTINCT ON with HAVING"
    SELECT DISTINCT ON (k) k FROM t HAVING k > 1
) AS s ON s.k = f.k

-- The portable spelling of the same dedup: a select item that is exactly
-- `row_number() OVER (PARTITION BY k...)` has distinct values among the rows
-- sharing `k...`, so `(k..., rn)` is a Unique Set of the relation that
-- computes it, and a filter that pins `rn` leaves `k...` unique.
-- case: row_number_in_a_subquery_filtered_to_one_makes_the_partition_key_unique
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT id, k, v FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ PROVED
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: row_number_in_a_cte_filtered_to_one_makes_a_join_on_the_key_many_to_one
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

WITH ranked AS (
    SELECT t.*, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM t
)
SELECT f.g, ranked.v
FROM f
/**ASSERT MANY TO ONE**/ JOIN ranked ON ranked.k = f.k AND ranked.rn = 1  --~ PROVED
/**ASSERT MANY TO ONE**/ JOIN ranked AS other ON other.k = f.k  --~ UNKNOWN

-- case: row_number_filtered_to_one_in_the_outer_where_joins_many_to_one
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

WITH ranked AS (
    SELECT id, k, v, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM t
), latest AS (
    SELECT id, k, v FROM ranked WHERE rn = 1
)
SELECT *
FROM f
/**ASSERT MANY TO ONE**/ JOIN latest ON latest.k = f.k  --~ PROVED

-- The window item beside a star or other items leaves them their lineage:
-- the input's key still proves, and NOT NULL still follows.
-- case: a_row_number_item_leaves_the_other_columns_their_facts
CREATE TABLE t (id INTEGER PRIMARY KEY, k INTEGER NOT NULL, v INTEGER, ts INTEGER);
CREATE TABLE f (id INTEGER, k INTEGER, g INTEGER);

WITH ranked AS (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
)
SELECT *
FROM f
/**ASSERT MANY TO ONE**/ JOIN ranked ON ranked.id = f.id  --~ PROVED

-- case: a_row_number_item_among_explicit_items_keeps_their_not_null
CREATE TABLE t (id INTEGER PRIMARY KEY, k INTEGER NOT NULL, v INTEGER, ts INTEGER);

SELECT id, k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn, v + 1 AS w FROM t
/**ASSERT NOT NULL UNIQUE(id)**/  --~ PROVED
/**ASSERT NOT NULL(k)**/  --~ PROVED
/**ASSERT NOT NULL(rn)**/  --~ PROVED
/**ASSERT NOT NULL(w)**/  --~ UNKNOWN

-- case: the_relation_that_computes_a_row_number_has_the_partition_key_and_it_as_a_unique_set
CREATE TABLE t (id INTEGER, k INTEGER, j INTEGER, v INTEGER, ts INTEGER);

SELECT id, k, j, v, ROW_NUMBER() OVER (PARTITION BY k, j ORDER BY ts) AS rn FROM t
/**ASSERT UNIQUE(k, j, rn)**/  --~ PROVED
/**ASSERT UNIQUE(k, rn)**/  --~ UNKNOWN
/**ASSERT UNIQUE(k, j)**/  --~ UNKNOWN
/**ASSERT UNIQUE(rn)**/  --~ UNKNOWN

-- case: a_composite_partition_key_is_unique_only_as_a_whole
CREATE TABLE t (id INTEGER, k INTEGER, j INTEGER, v INTEGER, ts INTEGER);
CREATE TABLE f (k INTEGER, j INTEGER, g INTEGER);

WITH ranked AS (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k, j ORDER BY ts) AS rn FROM t
)
SELECT *
FROM f
/**ASSERT MANY TO ONE**/ JOIN ranked ON ranked.k = f.k AND ranked.j = f.j AND ranked.rn = 1  --~ PROVED
/**ASSERT MANY TO ONE**/ JOIN ranked AS r2 ON r2.k = f.k AND r2.rn = 1  --~ UNKNOWN
/**ASSERT MANY TO ONE**/ JOIN ranked AS r3 ON r3.k = f.k AND r3.j = f.j  --~ UNKNOWN

-- Without PARTITION BY the row numbers are distinct among all rows: one is
-- unique, and pinned, the relation has at most one row.
-- case: row_number_without_a_partition_is_unique_by_itself
CREATE TABLE t (id INTEGER, v INTEGER, ts INTEGER);

SELECT id, v, ROW_NUMBER() OVER (ORDER BY ts) AS rn FROM t
/**ASSERT UNIQUE(rn)**/  --~ PROVED
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN

-- case: row_number_without_a_partition_filtered_to_one_leaves_at_most_one_row
CREATE TABLE t (id INTEGER, v INTEGER, ts INTEGER);

SELECT id, v FROM (SELECT *, ROW_NUMBER() OVER (ORDER BY ts) AS rn FROM t) WHERE rn = 1
/**ASSERT UNIQUE(v)**/  --~ PROVED

-- Any constant pins the row number, in any spelling of the filter.
-- case: row_number_filtered_to_another_constant_leaves_the_key_unique
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE rn = 3
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: row_number_compared_the_other_way_round_leaves_the_key_unique
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE 1 = rn
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: row_number_filtered_null_safely_leaves_the_key_unique
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE rn IS NOT DISTINCT FROM 1
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: the_pinning_filter_may_have_other_conjuncts
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE v > 0 AND rn = 1 AND id IS NOT NULL
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- Rows removed before the window renumber the partitions; rows removed after
-- it leave the numbers distinct.
-- case: a_filter_before_the_window_keeps_the_unique_set
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t WHERE v > 0
/**ASSERT UNIQUE(k, rn)**/  --~ PROVED

-- case: a_limit_after_the_window_keeps_the_unique_set
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t LIMIT 5
/**ASSERT UNIQUE(k, rn)**/  --~ PROVED

-- case: a_qualify_beside_the_window_item_keeps_the_unique_set
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t QUALIFY rn <= 2
/**ASSERT UNIQUE(k, rn)**/  --~ PROVED

-- case: a_distinct_select_with_a_row_number_keeps_the_unique_set
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT DISTINCT v, k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
/**ASSERT UNIQUE(k, rn)**/  --~ PROVED

-- case: a_row_number_over_a_key_that_is_a_selected_expression
CREATE TABLE t (id INTEGER, name VARCHAR, ts INTEGER);

SELECT lower(name) AS n, ROW_NUMBER() OVER (PARTITION BY lower(name) ORDER BY ts) AS rn FROM t
/**ASSERT UNIQUE(n, rn)**/  --~ PROVED

-- The rank functions repeat on ties.
-- case: rank_is_not_a_row_number
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, RANK() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: dense_rank_is_not_a_row_number
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, DENSE_RANK() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_rank_item_has_no_unique_set
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT k, RANK() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
/**ASSERT UNIQUE(k, rn)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_row_number_filtered_to_a_range_leaves_the_key_repeating
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE rn <= 2
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: a_row_number_filtered_below_two_leaves_the_key_repeating
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) WHERE rn < 2
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: an_unfiltered_row_number_leaves_the_key_repeating
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t)
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: a_filter_that_pins_the_row_number_only_on_some_rows_leaves_the_key_repeating
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE rn = 1 OR v > 0
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: a_filter_on_another_column_does_not_pin_the_row_number
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE v = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- case: a_filter_on_the_partition_key_does_not_pin_the_row_number
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT v FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE k = 1
/**ASSERT UNIQUE(v)**/  --~ UNKNOWN

-- The row number is exactly the window call: a computation over it is no row
-- number, whether it is the item or the filtered expression.
-- case: an_item_computed_from_a_row_number_is_not_one
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) - 1 AS rn FROM t
) AS a
WHERE rn = 0
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_cast_row_number_item_is_not_one
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, CAST(ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS BIGINT) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_filter_on_an_expression_over_the_row_number_does_not_pin_it
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE rn + 0 = 1 AND rn * 1 = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- Parentheses around the window call change nothing.
-- case: a_parenthesized_row_number_is_one
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, (ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts)) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- A key that is not one value per row, or that is no selected item, states
-- nothing.
-- case: a_row_number_over_a_non_deterministic_key_states_nothing
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT id, rn FROM (
    SELECT id, ROW_NUMBER() OVER (PARTITION BY random() ORDER BY ts) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_row_number_over_a_literal_key_states_nothing
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT k, ROW_NUMBER() OVER (PARTITION BY 1 ORDER BY ts) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_row_number_over_a_key_that_is_not_selected_states_nothing
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT id FROM (
    SELECT id, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(id)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- A bare name that may read a select alias is not a key.
-- case: a_row_number_over_a_name_an_alias_shadows_states_nothing
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT dept FROM (
    SELECT k AS dept, id AS k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(dept)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- A named window may add partition keys the item does not write.
-- case: a_row_number_over_a_named_window_states_nothing
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT *, ROW_NUMBER() OVER w AS rn FROM t WINDOW w AS (PARTITION BY k ORDER BY ts)
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN, unsupported-construct "a window function"

-- case: a_row_number_over_a_join_keeps_each_inputs_facts
CREATE TABLE t (id INTEGER PRIMARY KEY, k INTEGER, ts INTEGER);
CREATE TABLE d (k INTEGER PRIMARY KEY, name VARCHAR);

SELECT k, name FROM (
    SELECT t.k, d.name, ROW_NUMBER() OVER (PARTITION BY t.k ORDER BY t.ts) AS rn FROM t JOIN d ON d.k = t.k
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ PROVED
/**ASSERT DETERMINES(k -> name)**/  --~ PROVED

-- A join that repeats the row-numbered rows repeats the key.
-- case: a_row_number_through_a_join_that_repeats_its_rows_is_not_unique
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

SELECT a.k
FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t) AS a
JOIN f ON f.k = a.k
WHERE a.rn = 1
/**ASSERT UNIQUE(k)**/  --~ UNKNOWN

-- The spelling every engine without QUALIFY uses.
-- case: postgres_row_number_in_a_cte_filtered_to_one_makes_the_key_unique
-- dialect: postgres
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);
CREATE TABLE f (k INTEGER, g INTEGER);

WITH ranked AS (
    SELECT t.*, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM t
)
SELECT f.g
FROM f
/**ASSERT MANY TO ONE**/ JOIN ranked ON ranked.k = f.k AND ranked.rn = 1  --~ PROVED

-- case: mysql_row_number_in_a_subquery_filtered_to_one_makes_the_key_unique
-- dialect: mysql
CREATE TABLE t (id INTEGER, k INTEGER, v INTEGER, ts INTEGER);

SELECT id, k, v FROM (
    SELECT t.*, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: spark_row_number_in_a_subquery_filtered_to_one_makes_the_key_unique
-- dialect: spark
CREATE TABLE t (id INT, k INT, v INT, ts INT);

SELECT id, k, v FROM (
    SELECT t.*, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM t
) AS a
WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ PROVED

-- case: trino_row_number_filtered_to_one_makes_the_key_unique
-- dialect: trino
CREATE TABLE t (id INTEGER, k INTEGER, ts INTEGER);

SELECT k FROM (
    SELECT k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY ts) AS rn FROM t
) WHERE rn = 1
/**ASSERT UNIQUE(k)**/  --~ PROVED
