-- Every written marker is accounted for: it states an Assertion or a Property
-- Declaration, or it is reported by a Diagnostic on its own line.
--
-- A marker that vanishes reads to its author as a proof, so this is checked
-- across every marker kind and every place a marker can be written, including
-- places the analysis does not model.

-- case: a_column_a_select_with_unknown_columns_cannot_resolve_is_diagnosed
SELECT * FROM a JOIN b ON a.id = b.aid /**ASSERT UNIQUE(name)**/
--~ unresolved-asserted-column "name"
--~! undeclared-table
--~! undeclared-table

-- case: markers_sharing_a_line_are_accounted_for_separately
CREATE TABLE t (id INT PRIMARY KEY);
CREATE TABLE u (id INT PRIMARY KEY);
SELECT id FROM t WHERE id IN (SELECT id FROM u /**ASSERT UNIQUE(id)**/)  --~ PROVED
/**ASSERT UNIQUE(id)**/  --~ PROVED

-- case: join_markers_sharing_a_line_are_accounted_for_separately
CREATE TABLE t (id INT PRIMARY KEY);
CREATE TABLE u (id INT PRIMARY KEY);
SELECT t.id
FROM t
/**ASSERT MANY TO ONE**/ JOIN u  --~ PROVED
    ON t.id = u.id
WHERE t.id IN (SELECT u.id FROM u
/**ASSERT MANY TO ONE**/ JOIN t ON t.id = u.id)  --~ PROVED

-- case: a_marker_in_a_line_comment_is_switched_off
CREATE TABLE users (id INTEGER PRIMARY KEY);
CREATE TABLE sessions (user_id INTEGER);
SELECT *
FROM sessions
-- /**ASSERT MANY TO ONE**/
JOIN users ON sessions.user_id = users.id

-- case: a_mistyped_marker_in_a_line_comment_is_not_reported
CREATE TABLE t (a INTEGER);
SELECT a FROM t  -- /**ASERT UNIQUE(a)**/

-- case: a_marker_in_a_string_literal_is_text
CREATE TABLE t (a INTEGER);
SELECT a, '/**ASSERT UNIQUE(a)**/' AS note FROM t

-- case: a_live_marker_after_a_commented_one_is_counted
CREATE TABLE t (a INTEGER PRIMARY KEY);
-- /**ASSERT NOT NULL(a)**/ was here
SELECT a FROM t /**ASSERT UNIQUE(a)**/  --~ PROVED

-- case: a_marker_in_a_string_with_an_escaped_quote_is_text
CREATE TABLE t (a INTEGER);
SELECT a, 'it''s /**ASSERT UNIQUE(a)**/' AS note FROM t

-- case: a_marker_in_a_multi_line_string_is_text
CREATE TABLE t (a INTEGER);
SELECT a, 'first line
/**ASSERT UNIQUE(a)**/' AS note FROM t
